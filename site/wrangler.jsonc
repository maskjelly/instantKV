{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "instantkv-site",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "observability": {
    "enabled": true,
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/demo", "/api/demo/*"],
    "not_found_handling": "404-page",
    "html_handling": "force-trailing-slash",
  },
  "env": {
    "production": {
      "name": "instantkv-site",
      "assets": {
        "directory": "./dist",
        "binding": "ASSETS",
        "run_worker_first": ["/api/demo", "/api/demo/*"],
        "not_found_handling": "404-page",
        "html_handling": "force-trailing-slash",
      },
      "routes": [
        {
          "pattern": "instantkv.com",
          "custom_domain": true,
        },
      ],
    },
  },
}
