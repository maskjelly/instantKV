{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "instantkv-site",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "observability": { "enabled": true },
  "secrets": { "required": ["DEMO_GATEWAY_TOKEN"] },
  "vars": { "DEMO_ORIGIN": "https://45.196.196.251/instantkv-demo" },
  "ratelimits": [
    {
      "name": "DEMO_RATE_LIMIT",
      "namespace_id": "8461001",
      "simple": { "limit": 240, "period": 60 },
    },
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/demo/*"],
    "not_found_handling": "404-page",
    "html_handling": "force-trailing-slash",
  },
  "env": {
    "production": {
      "name": "instantkv-site",
      "secrets": { "required": ["DEMO_GATEWAY_TOKEN"] },
      "assets": {
        "directory": "./dist",
        "binding": "ASSETS",
        "run_worker_first": ["/api/demo/*"],
        "not_found_handling": "404-page",
        "html_handling": "force-trailing-slash",
      },
      "vars": { "DEMO_ORIGIN": "https://45.196.196.251/instantkv-demo" },
      "ratelimits": [
        {
          "name": "DEMO_RATE_LIMIT",
          "namespace_id": "8461001",
          "simple": { "limit": 240, "period": 60 },
        },
      ],
      "routes": [{ "pattern": "instantkv.com", "custom_domain": true }],
    },
  },
}
