{
  "name": "instantkv-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "check": "prettier --check . && astro check && tsc -p worker/tsconfig.json",
    "test": "node --experimental-strip-types --test worker/index.test.ts",
    "format": "prettier --write .",
    "build": "astro build && pagefind --site dist",
    "preview": "wrangler dev --ip 127.0.0.1",
    "verify": "node scripts/verify.mjs",
    "deploy": "npm run check && npm run build && npm run verify && wrangler deploy",
    "deploy:domain": "npm run check && npm run build && npm run verify && wrangler deploy --env production"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.1",
    "@astrojs/sitemap": "3.7.4",
    "astro": "7.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@cloudflare/workers-types": "5.20261001.1",
    "pagefind": "1.5.2",
    "prettier": "3.9.9",
    "prettier-plugin-astro": "1.1.0",
    "typescript": "~5.9.3",
    "wrangler": "4.145.0"
  }
}
