---
import Base from '../layouts/Base.astro';
---

<Base
  title="Search documentation"
  description="Search instantKV setup, feature, API, operations and contributor documentation. The index runs locally in your browser."
>
  <main id="main" class="container search-page section">
    <div class="page-intro">
      <span class="eyebrow">Local search / no account needed</span>
      <h1>Find your next step.</h1>
      <p>Search guides, commands, configuration and engineering notes.</p>
    </div>
    <label class="eyebrow" for="search">
      SEARCH DOCUMENTATION
    </label>
    <input
      id="search"
      class="search-input"
      type="search"
      placeholder="Try checkpoints, MCP, quotas…"
      autocomplete="off"
    />
    <p class="search-status" id="search-status" role="status">
      Enter a term to search the documentation.
    </p>
    <ul
      id="search-results"
      class="search-results"
      aria-label="Search results"
    ></ul>
    <noscript>
      <p>
        Use the{' '}
        <a class="text-link" href="/docs/">
          documentation index
        </a>{' '}
        to browse without JavaScript.
      </p>
    </noscript>
  </main>
  <script>
    const input = document.querySelector<HTMLInputElement>('#search')!;
    const status = document.querySelector('#search-status')!;
    const results = document.querySelector('#search-results')!;
    let timer: ReturnType<typeof setTimeout>;
    let request = 0;
    const modulePath = '/pagefind/pagefind.js';
    const engine = import(/* @vite-ignore */ modulePath);
    async function search() {
      const current = ++request;
      const term = input.value.trim();
      results.replaceChildren();
      if (!term) {
        status.textContent = 'Enter a term to search the documentation.';
        return;
      }
      status.textContent = 'Searching…';
      try {
        const pagefind = await engine;
        const response = await pagefind.search(term);
        const entries = await Promise.all(
          response.results.slice(0, 20).map(
            (r: {
              data: () => Promise<{
                url: string;
                meta: { title?: string };
                excerpt: string;
              }>;
            }) => r.data(),
          ),
        );
        if (current !== request) return;
        status.textContent = response.results.length
          ? `${response.results.length} results for “${term}”`
          : `No results for “${term}”. Try a feature or command name.`;
        for (const entry of entries) {
          const li = document.createElement('li');
          li.className = 'search-result';
          const heading = document.createElement('h2');
          const link = document.createElement('a');
          link.href = entry.url;
          link.textContent = entry.meta.title || entry.url;
          heading.append(link);
          const excerpt = document.createElement('p');
          excerpt.textContent = new DOMParser().parseFromString(
            entry.excerpt,
            'text/html',
          ).body.textContent;
          li.append(heading, excerpt);
          results.append(li);
        }
      } catch {
        if (current === request)
          status.textContent =
            'Search is unavailable. Browse the documentation index at /docs/.';
      }
    }
    input.value = new URLSearchParams(location.search).get('q') || '';
    if (input.value) void search();
    input.addEventListener('input', () => {
      clearTimeout(timer);
      timer = setTimeout(search, 200);
    });
  </script>
</Base>
