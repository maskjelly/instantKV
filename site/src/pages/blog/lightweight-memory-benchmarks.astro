---
import { getEntry, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
const entry = await getEntry('guides', 'memory-benchmark-notes');
if (!entry) throw new Error('Missing memory benchmark article');
const { Content } = await render(entry);
---

<Base
  title="Small memory. Measured tradeoffs."
  description="How instantKV uses BM25 to keep local memory small, where it beats Supermemory local and where semantic retrieval wins."
>
  <main id="main" class="shell blog-page" data-pagefind-body>
    <article>
      <header class="docs-title">
        <p class="data-label">Engineering notes / 4 October 2026</p>
        <h1>Small memory. Measured tradeoffs.</h1>
        <p>
          Five retrieval workloads. One local Rust engine. Wins and losses
          included.
        </p>
      </header>
      <div class="prose">
        <Content />
      </div>
      <a class="text-link" href="/benchmarks/">
        All measurements and raw reports →
      </a>
    </article>
  </main>
</Base>

<style>
  .blog-page {
    max-width: 820px;
    padding-block: 48px 64px;
  }
</style>
