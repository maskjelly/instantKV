---
import Base from '../layouts/Base.astro';
---

<Base
  title="Page not found"
  description="This page does not exist. Browse the instantKV documentation or return to the homepage."
>
  <main id="main" class="shell not-found">
    <p class="data-label">404</p>
    <h1>Page not found.</h1>
    <p>Find the guide you need in the documentation index.</p>
    <div class="button-row">
      <a class="button button--key" href="/docs/">
        Browse docs →
      </a>
      <a class="button" href="/">
        Home
      </a>
    </div>
  </main>
</Base>
