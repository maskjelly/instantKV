---
import Base from '../layouts/Base.astro';
---

<Base
  title="Memory demo"
  description="Try remember, recall, browse and forget on the current Rust memory API. Filter synthetic memories by topic, tag, event time and keywords."
>
  <main id="main" class="shell demo-page" data-pagefind-body>
    <header class="demo-head">
      <div>
        <p class="eyebrow" id="demo-source-label">
          Live memory API / real Rust storage
        </p>
        <h1>Remember. Find. Forget.</h1>
        <p>
          Save structured memories. Clear your browser context. Find the facts
          again by topic, tag, time or keywords.
        </p>
      </div>
      <a class="text-link" href="/benchmarks/">
        Current measurements ↗
      </a>
    </header>
    <div class="demo-controls">
      <label>
        Demo source
        <select id="demo-source">
          <option value="live">Live memory API</option>
          <option value="recorded">Recorded Mac responses</option>
        </select>
      </label>
      <label>
        Memories
        <select id="memory-count">
          <option value="100">100</option>
          <option value="1000">1,000</option>
          <option value="10000">10,000</option>
        </select>
      </label>
      <p class="demo-controls-note" id="source-note">
        Synthetic data only. Durable storage with a 15-minute TTL. No model
        runs.
      </p>
    </div>
    <section
      class="demo-bench"
      aria-label="Memory writer and independent reader"
    >
      <article class="demo-station">
        <div class="panel-head">
          <span class="data-label">01 / remember</span>
          <span class="data-label">Content + labels + time + metadata</span>
        </div>
        <h2>Save a little context.</h2>
        <label for="memory-content">
          Synthetic context · padded to 512 characters
        </label>
        <textarea
          id="memory-content"
          rows="3"
          maxlength="128"
        >Prefer Rust for local tools. Keep source references with each decision.</textarea>
        <p class="u-micro">
          Fixtures use four topics, two session-scoped tags and one-minute event
          times. These are test facts, not model conversations.
        </p>
        <div class="demo-actions">
          <button id="start-run" class="button button--key" type="button">
            Remember 100 →
          </button>
          <button id="stop-run" class="button" type="button" disabled>
            Pause
          </button>
          <button id="new-run" class="button" type="button">
            New run
          </button>
        </div>
        <div class="demo-progress">
          <span id="write-count">0 / 100 acknowledged</span>
          <span id="write-percent">0%</span>
        </div>
        <progress
          id="write-progress"
          value="0"
          max="100"
          aria-label="Acknowledged memories"
        ></progress>
        <div class="panel-head u-gap-top-lg">
          <span class="data-label">Memory fields / example</span>
          <button id="clear-context" class="demo-link-button" type="button">
            Clear local context
          </button>
        </div>
        <pre
          class="terminal"
          id="write-preview"
          tabindex="0"
        >Remember some memories to see the fields sent to Rust.</pre>
        <p class="u-micro">
          Clearing context removes displayed values. In live mode, the reader
          fetches from storage using only the session locator.
        </p>
        <a
          id="reader-tab"
          class="text-link"
          href="/demo/"
          target="_blank"
          rel="noopener"
          hidden
        >
          Open an independent reader ↗
        </a>
      </article>
      <article class="demo-station">
        <div class="panel-head">
          <span class="data-label">02 / recall + browse</span>
          <span class="data-label">10 results / 16 KiB page</span>
        </div>
        <h2>Find the useful facts.</h2>
        <div id="live-filters" class="memory-filters">
          <label>
            Topic
            <select id="filter-topic">
              <option value="">All topics</option>
              <option>preferences</option>
              <option>project</option>
              <option>decisions</option>
              <option>tasks</option>
            </select>
          </label>
          <label>
            Tag
            <select id="filter-tag">
              <option value="">All tags</option>
              <option>local</option>
              <option>offline</option>
            </select>
          </label>
          <label class="filter-wide">
            Keywords
            <input
              id="filter-query"
              type="text"
              placeholder="Rust local"
              maxlength="128"
            />
          </label>
          <label>
            From event time
            <input id="filter-since" type="datetime-local" step="60" />
          </label>
          <label>
            To event time
            <input id="filter-until" type="datetime-local" step="60" />
          </label>
        </div>
        <label id="recorded-filters" hidden>
          Saved query
          <select id="query-preset">
            <option value="browse">Browse, latest first</option>
            <option value="topic">Topic: preferences</option>
            <option value="tag">Tag: local</option>
            <option value="time">Time: last 20 events</option>
            <option value="keyword">Keywords: Rust local</option>
            <option value="combined">Topic + tag + keyword</option>
          </select>
        </label>
        <div class="demo-actions">
          <button
            id="recall-memories"
            class="button button--key"
            type="button"
            disabled
          >
            Recall →
          </button>
          <button id="browse-memories" class="button" type="button" disabled>
            Browse all
          </button>
          <button id="next-page" class="button" type="button" disabled>
            Next page
          </button>
        </div>
        <p class="u-micro" id="query-summary">
          Remember some memories first. Keywords match literal text; there is no
          semantic search.
        </p>
        <div
          id="memory-results"
          class="memory-results"
          aria-live="polite"
        ></div>
        <details>
          <summary>Full storage response</summary>
          <pre
            class="terminal terminal--tall"
            id="query-output"
            tabindex="0"
          >No query yet.</pre>
        </details>
      </article>
    </section>
    <section class="memory-detail" aria-label="Exact memory and deletion">
      <div>
        <p class="data-label">03 / exact read + forget</p>
        <h2>Inspect one. Delete it.</h2>
        <label for="record-index">Memory index</label>
        <div class="demo-read-controls">
          <input
            id="record-index"
            type="number"
            value="0"
            min="0"
            max="0"
            disabled
          />
          <button id="read-record" class="button" type="button" disabled>
            Read key
          </button>
          <button id="forget-record" class="button" type="button" disabled>
            Forget
          </button>
        </div>
        <p id="read-verification" class="u-micro">
          Read a saved memory before deleting it.
        </p>
        <p class="u-micro">
          Forget uses the current revision. The memory and its index entries are
          deleted in one transaction.
        </p>
      </div>
      <pre
        class="terminal"
        id="read-output"
        tabindex="0"
      >Select a result or read an exact index.</pre>
    </section>
    <section
      class="instruments"
      aria-label="Measured operation statistics"
      style="--cols:4"
    >
      <div>
        <span class="data-label">Acknowledged saves</span>
        <strong id="metric-count">0</strong>
        <small>memories · create-only</small>
      </div>
      <div>
        <span class="data-label">Save p50 / p99</span>
        <strong id="metric-save">—</strong>
        <small>ms · HTTP to Rust · 16 concurrent</small>
      </div>
      <div>
        <span class="data-label">Last query / backend</span>
        <strong id="metric-query">—</strong>
        <small>ms · HTTP to Rust</small>
      </div>
      <div>
        <span class="data-label" id="client-timing-label">
          Last query / browser
        </span>
        <strong id="metric-client">—</strong>
        <small id="client-timing-note">ms · includes public network</small>
      </div>
    </section>
    <p id="demo-status" class="demo-status" role="status" aria-live="polite">
      Ready to remember. Each live request calls the current memory API.
    </p>
    <section class="demo-notes">
      <p>
        <strong>Live mode.</strong> The Rust service runs on our shared VPS. The
        website forwards requests through a private demo gateway. It shows
        actual responses. Browser timing includes the network. Backend timing
        includes HTTP and JSON parsing. These numbers are separate from local
        benchmarks.
      </p>
      <p>
        <strong>Recorded mode.</strong> Open saved responses from the median of
        three fresh Mac runs. Filter controls select queries that actually ran.
        The browser makes no storage calls in this mode. Forget is available in
        live mode; recordings retain the original deletion receipt.
      </p>
      <p>
        Records and session locators expire after 15 minutes. An expired session
        needs a new run. The demo stores only synthetic fixtures. The memory
        service itself needs no cloud API or embedding model.
      </p>
      <p class="u-cluster">
        <a class="text-link" href="/docs/live-demo/">
          Demo guide →
        </a>
        <a class="text-link" href="/recordings/memory/replay.json">
          Download recorded responses →
        </a>
        <a class="text-link" href="/docs/memory-mvp/">
          Use the memory tools locally →
        </a>
      </p>
    </section>
    <noscript>
      <p>
        The interactive demo requires JavaScript. Follow the{' '}
        <a href="/docs/memory-mvp/">memory guide</a> to run the five CLI tools.
      </p>
    </noscript>
  </main>
  <script src="../scripts/demo.ts"></script>
</Base>
<style>
  .demo-page [hidden] {
    display: none;
  }
  .demo-controls {
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  }
  .demo-controls-note {
    grid-column: 1 / -1;
  }
  .memory-filters {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 16px;
  }
  .filter-wide {
    grid-column: 1 / -1;
  }
  .memory-filters input,
  .memory-filters select,
  #query-preset {
    width: 100%;
    min-width: 0;
    margin-top: 8px;
  }
  .memory-results {
    display: grid;
    gap: 12px;
    margin: 20px 0;
  }
  .memory-results :global(button) {
    text-align: left;
    width: 100%;
    background: transparent;
    border: 0;
    border-bottom: 1px solid var(--line);
    padding: 12px 0;
    font: inherit;
    cursor: pointer;
  }
  .memory-results :global(small) {
    display: block;
    color: var(--ink-3);
    margin-bottom: 6px;
  }
  .memory-results :global(span) {
    display: block;
    overflow-wrap: anywhere;
  }
  .memory-detail {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 40px;
    padding: 36px 0;
    border-bottom: 1px solid var(--line);
  }
  .memory-detail h2 {
    margin: 10px 0 20px;
  }
  .memory-detail .demo-read-controls {
    grid-template-columns: 80px 1fr 1fr;
    margin: 12px 0;
  }
  .memory-detail .terminal {
    margin: 0;
    max-height: 400px;
    overflow: auto;
  }
  @media (max-width: 768px) {
    .memory-detail {
      grid-template-columns: 1fr;
      gap: 24px;
    }
  }
  @media (max-width: 390px) {
    .memory-filters {
      grid-template-columns: 1fr;
    }
  }
</style>
