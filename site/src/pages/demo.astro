---
import Base from '../layouts/Base.astro';
import DemoFlowDiagram from '../components/diagrams/DemoFlowDiagram.astro';
---

<Base
  title="Memory demo"
  description="Replay real 100,000-record Mac measurements with cached exact responses, or switch to live writes on our demo server."
>
  <main id="main" class="shell demo-page" data-pagefind-body>
    <header class="demo-head">
      <div>
        <p class="eyebrow" id="demo-source-label">
          <b>Recorded Mac run</b> / real Rust engine
        </p>
        <h1>100,000 memories. One exact recall.</h1>
        <p>
          Replay a measured Mac run, then recall a saved response from the
          reader. Switch to Live VPS to write your own synthetic records.
        </p>
      </div>
      <p class="data-label">
        <span class="signal"></span>
        <span id="demo-path">RECORDED ON MAC → CLIENT CACHE</span>
      </p>
    </header>

    <div class="demo-controls">
      <label>
        Demo source
        <select id="demo-source">
          <option value="recorded">Recorded Mac · 2× playback</option>
          <option value="live">Live VPS · actual requests</option>
        </select>
      </label>
      <label>
        Storage mode
        <select id="storage-mode">
          <option value="cache">RAM cache · 15-minute TTL</option>
          <option value="durable">Durable redb · 15-minute TTL</option>
        </select>
      </label>
      <label>
        Memories
        <select id="memory-count">
          <option value="1000">1,000</option>
          <option value="10000" selected>
            10,000
          </option>
          <option value="50000">50,000</option>
          <option value="100000">100,000</option>
        </select>
      </label>
      <label>
        Context length
        <select id="value-size">
          <option value="256">256 characters</option>
          <option value="512" selected>
            512 characters
          </option>
          <option value="1024">1,024 characters</option>
        </select>
      </label>
      <p class="demo-controls-note">
        64 synthetic agents
        <br />
        16 concurrent backend requests
      </p>
    </div>

    <section class="demo-bench" aria-label="Independent writer and reader">
      <article class="demo-station">
        <div class="panel-head">
          <span class="data-label">01 / Writer</span>
          <span class="data-label" id="writer-path">
            RECORDED PUT TRACE
          </span>
        </div>
        <h2>Give the fleet a memory.</h2>
        <label for="memory-content">Context to store in each record</label>
        <textarea
          id="memory-content"
          rows="3"
          maxlength="128"
        >Use Rust + redb. Shared knowledge is read-only for workers. Keep source references with every decision.</textarea>
        <div class="demo-actions">
          <button
            id="start-run"
            class="button button--key"
            type="button"
            disabled
          >
            Store 10,000 memories →
          </button>
          <button id="stop-run" class="button" type="button" disabled>
            Pause
          </button>
          <button id="new-run" class="button" type="button">
            New run
          </button>
        </div>
        <div class="demo-progress">
          <span id="write-count">0 / 10,000 acknowledged</span>
          <span id="write-percent">0%</span>
        </div>
        <progress
          id="write-progress"
          value="0"
          max="10000"
          aria-label="Acknowledged writes"
        ></progress>
        <div class="memory-grid" id="memory-grid" aria-hidden="true"></div>
        <p class="u-micro" id="demo-cell-caption">
          Recorded writes replay at 2× speed. Measured numbers stay unchanged.
        </p>

        <div class="panel-head u-gap-top-lg">
          <span class="data-label">Generated record / preview</span>
          <button id="clear-context" class="demo-link-button" type="button">
            Clear local context
          </button>
        </div>
        <pre
          class="terminal"
          id="write-preview"
          tabindex="0"
        >Start a run to generate synthetic agent records.</pre>
      </article>

      <article class="demo-station">
        <div class="panel-head">
          <span class="data-label">02 / Reader</span>
          <span class="data-label" id="reader-path">
            SAVED GET RESPONSE
          </span>
        </div>
        <h2>Read it back.</h2>
        <label for="record-index">
          Record index · <span id="read-range">load memories first</span>
        </label>
        <div class="demo-read-controls">
          <select
            id="recorded-index"
            aria-label="Recorded storage response"
            hidden
          ></select>
          <input
            id="record-index"
            type="number"
            value="0"
            min="0"
            max="0"
            disabled
          />
          <button id="random-record" class="button" type="button" disabled>
            Random
          </button>
          <button
            id="read-record"
            class="button button--key"
            type="button"
            disabled
          >
            Recall →
          </button>
        </div>

        <div class="demo-timings">
          <div>
            <span class="data-label" id="read-client-label">
              Client cache lookup
            </span>
            <strong id="read-browser-ms">
              — <small>ms</small>
            </strong>
          </div>
          <div>
            <span class="data-label" id="read-backend-label">
              Recorded backend HTTP read
            </span>
            <strong id="read-backend-ms">
              — <small>ms</small>
            </strong>
          </div>
        </div>

        <p class="u-micro demo-timing-note" id="read-timing-note">
          Browser memory lookup only. A short lookup can fall within one clock
          tick; that does not mean it took zero time.
        </p>
        <div class="demo-status-line">
          <span id="read-verification">Waiting for a stored record</span>
          <a
            id="reader-tab"
            href="/demo/"
            target="_blank"
            rel="noopener"
            hidden
          >
            Open reader in new tab ↗
          </a>
        </div>
        <pre
          class="terminal terminal--tall"
          id="read-output"
          tabindex="0"
        >Store some memories, choose a record and press Recall.

This reader fetches the saved value from instantKV's Rust service. You can also open it in a separate tab.</pre>
        <p class="u-micro" id="read-key">
          Exact key and revision will appear here.
        </p>
      </article>
    </section>

    <section class="instruments" aria-label="Measured write statistics">
      <div>
        <span class="data-label">Acknowledged</span>
        <strong id="metric-count">0</strong>
        <small>records stored</small>
      </div>
      <div>
        <span class="data-label">Payload written</span>
        <strong id="metric-bytes">0</strong>
        <small>MiB · JSON values</small>
      </div>
      <div>
        <span class="data-label">End-to-end rate</span>
        <strong id="metric-rate">—</strong>
        <small>records / second</small>
      </div>
      <div>
        <span class="data-label">Backend p50</span>
        <strong id="metric-p50">—</strong>
        <small>ms / record</small>
      </div>
      <div>
        <span class="data-label">Backend p99</span>
        <strong id="metric-p99">—</strong>
        <small>ms / record</small>
      </div>
      <div>
        <span class="data-label">Failed requests</span>
        <strong id="metric-errors">0</strong>
        <small id="error-unit">measured run errors</small>
      </div>
    </section>

    <section class="trace" aria-label="Measured write latency trace">
      <div class="panel-head">
        <span class="data-label" id="trace-label">
          Recorded local batch round-trip
        </span>
        <span id="trace-summary" class="u-micro">
          No measurements yet
        </span>
      </div>
      <svg
        viewBox="0 0 1000 120"
        role="img"
        aria-label="Latency of each acknowledged write batch, in milliseconds"
      >
        <path d="M0 30H1000 M0 60H1000 M0 90H1000" class="trace-rules" />
        <polyline id="latency-trace" points="" class="trace-line" />
      </svg>
      <p id="demo-status" class="demo-status" role="status" aria-live="polite">
        Recorded Mac mode. Playback changes animation speed, never the measured
        timings.
      </p>
    </section>

    <section class="demo-notes">
      <p>
        <strong>Recorded Mac mode.</strong> Three full runs of each workload on
        a Mac, with the middle throughput run used for replay. Responses were
        fetched from Rust during that run and are now cached in this browser.
        Recall offers four saved samples; it makes no new storage request. The
        cache lookup time is separate from the recorded backend read time.
        <a href="/recordings/mac/replay.json">Download the replay data</a>.
      </p>
      <p>
        <strong>Reading the timings.</strong> Browser time covers the full trip
        through Cloudflare and back. Backend time covers the coordinator’s HTTP
        request to Rust, including response parsing. Half the measured writes
        finish within p50; 99% finish within p99. These are the successful
        writes measured in Live VPS mode. Recorded mode shows local HTTP timings
        from the Mac, without Cloudflare or internet latency. Neither mode
        measures engine-only time or predicts another deployment's speed.
      </p>
      <p>
        Live VPS data expires after 15 minutes. RAM cache can be evicted under
        load and clears on restart. Durable mode commits through redb; its demo
        records also expire. This shared sandbox accepts synthetic context only.
        Static recordings remain available. Managed hosting is still in
        development.
      </p>
      <p class="u-cluster">
        <a class="text-link" href="/docs/live-demo/">
          How it works &amp; how to run it →
        </a>
        <a class="text-link" href="/benchmarks/">
          Controlled benchmarks →
        </a>
        <a class="text-link" href="/docs/quickstart/">
          Run your own node →
        </a>
      </p>
    </section>

    <section class="band band--tight diagram-band">
      <p class="diagram-guide">
        Live request path / scroll across to inspect details
      </p>
      <DemoFlowDiagram />
    </section>

    <noscript>
      <p>
        The interactive demo requires JavaScript. You can also run
        <code>instantkv demo --swarm</code> locally.
      </p>
    </noscript>
  </main>
  <script src="../scripts/demo-controller.ts"></script>
</Base>

<style>
  .demo-page [hidden] {
    display: none;
  }
  .demo-controls-note {
    grid-column: 1 / -1;
  }
  .demo-read-controls select {
    margin-top: 0;
  }
</style>
