---
import Base from '../layouts/Base.astro';
import { workloads, successful, errors, environment } from '../lib/benchmarks';
import macCache from '../../../docs/demo-results/2026-10-02-mac/cache-2.json';
import macDurable from '../../../docs/demo-results/2026-10-02-mac/durable-1.json';
const max = Math.max(...workloads.map((w) => w.rps));
const number = (value: number) => Math.round(value).toLocaleString('en-US');
---

<Base
  title="Benchmarks"
  description="Measured instantKV RAM and durable storage on an Apple M4 Pro and a VPS. Throughput, tail latency, hardware, reproduction commands and raw reports."
>
  <main id="main" class="shell" data-pagefind-body>
    <header class="page-intro">
      <p class="eyebrow">
        <b>Measured</b> / reproducible / open
      </p>
      <h1>Fast recall. Numbers included.</h1>
      <p>
        Local Mac runs and a shared VPS. Real authenticated HTTP, RAM caching
        and immediate durable commits. Hardware, request paths and raw results
        included.
      </p>
    </header>
    <section class="band" aria-label="Measured Mac demo runs">
      <p class="eyebrow">
        <b>New</b> / Apple M4 Pro / 24 GiB / 2026-10-02
      </p>
      <h2>100,000 memories. Measured on a Mac.</h2>
      <p>
        330,000 writes across six runs. 24 exact reads. Zero errors. The real
        demo coordinator talks to Rust over local HTTP with 16 concurrent
        requests. Each row is the median throughput run of three, with that same
        run's measured percentiles. These unique-record workloads differ from
        the VPS hot-key tests below.
      </p>
      <div class="table-scroll">
        <table>
          <thead>
            <tr>
              <th>Storage</th>
              <th>Records/run</th>
              <th>Writes/s</th>
              <th>PUT p50</th>
              <th>PUT p99</th>
              <th>Raw run</th>
            </tr>
          </thead>
          <tbody>
            {[macCache, macDurable].map((run) => (
              <tr>
                <td>
                  {run.mode === 'cache'
                    ? 'RAM cache'
                    : 'Immediate durable storage'}
                </td>
                <td>{number(run.count)}</td>
                <td>{number(run.records_per_second)}</td>
                <td>{run.latency_ms.p50.toFixed(3)} ms</td>
                <td>{run.latency_ms.p99.toFixed(3)} ms</td>
                <td>
                  <a href={`/recordings/mac/${run.mode}-${run.iteration}.json`}>
                    Download ↗
                  </a>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p>
        No Cloudflare or internet latency in these measurements. Durable writes
        came out slower on this Mac than the earlier VPS demo; faster hardware
        alone does not guarantee faster commits. Playback is 2× speed, while
        every performance figure stays as measured.
      </p>
      <p class="u-cluster">
        <a class="text-link" href="/demo/">
          Replay the Mac run →
        </a>
        <a class="text-link" href="/recordings/mac/README.md">
          Methodology & all six reports →
        </a>
      </p>
    </section>
    <div class="instruments" style="--cols: 4">
      <div>
        <span class="data-label">VPS successful requests</span>
        <strong>{number(successful)}</strong>
      </div>
      <div>
        <span class="data-label">Errors</span>
        <strong>{errors}</strong>
      </div>
      <div>
        <span class="data-label">VPS raw reports</span>
        <strong>15</strong>
      </div>
      <div>
        <span class="data-label">Measured on commit</span>
        <strong>
          <a
            class="text-link"
            href={`https://github.com/maskjelly/instantKV/tree/${environment.code_commit}`}
          >
            {environment.code_commit.slice(0, 7)}
          </a>
        </strong>
      </div>
    </div>
    <div class="bench-head">
      <h2>VPS request paths</h2>
      <div class="chart-controls" role="group" aria-label="Chart metric">
        <button data-metric="rps" aria-pressed="true">
          Throughput
        </button>
        <button data-metric="p50" aria-pressed="false">
          p50 latency
        </button>
        <button data-metric="p99" aria-pressed="false">
          p99 latency
        </button>
      </div>
    </div>
    <div class="chart" aria-label="Workload throughput and latency comparison">
      {workloads.map((w) => (
        <div
          class="chart-row"
          data-rps={w.rps}
          data-p50={w.p50}
          data-p99={w.p99}
        >
          <span>{w.name}</span>
          <div class="chart-bar-track">
            <div
              class="chart-bar"
              style={`width:${(w.rps / max) * 100}%`}
            ></div>
          </div>
          <span class="chart-value">{number(w.rps)} req/s</span>
        </div>
      ))}
    </div>
    <p class="chart-note" id="chart-note" aria-live="polite">
      Successful requests/sec · higher is better · median of three run results.
    </p>
    <div class="table-scroll">
      <table>
        <caption>All workload medians / latency is milliseconds</caption>
        <thead>
          <tr>
            <th>Workload</th>
            <th>Requests/run</th>
            <th>Concurrency</th>
            <th>Req/s</th>
            <th>p50</th>
            <th>p95</th>
            <th>p99</th>
          </tr>
        </thead>
        <tbody>
          {workloads.map((w) => (
            <tr>
              <td>
                {w.name}
                <small>{w.detail}</small>
              </td>
              <td>{number(w.requests)}</td>
              <td>{w.concurrency}</td>
              <td>{number(w.rps)}</td>
              <td>{w.p50.toFixed(2)}</td>
              <td>{w.p95.toFixed(2)}</td>
              <td>{w.p99.toFixed(2)}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <div class="bench-notes">
      <section>
        <h2>The test machine</h2>
        <ul>
          <li>4 KVM vCPUs at approximately 2.49 GHz; 7.56 GiB RAM.</li>
          <li>
            Ubuntu 20.04 host, Linux 5.15; Docker 28.1.1, Debian 12 runtime.
          </li>
          <li>
            Client and server share one container over loopback HTTP/1.1
            keep-alive. No pipelining.
          </li>
          <li>
            Existing services and load generators stayed active. Host load: 4.24
            before, 5.44 after.
          </li>
          <li>
            Post-run memory snapshot: 10.3 MiB. Database file: 3,379,200 bytes.
          </li>
        </ul>
        <p>
          <a class="text-link" href="/benchmark-data/environment.json">
            Download environment &amp; hashes ↗
          </a>
        </p>
      </section>
      <section>
        <h2>What these numbers mean</h2>
        <p>
          The tests repeatedly read or update a small set of keys on a shared
          machine. Setup, warmup and cleanup are outside timing. Each table cell
          is the middle result from three runs; we don't pool their latency
          samples.
        </p>
        <p>
          p50 is the middle request time; p99 is the time 99% of requests finish
          within. Knowledge reads use cached database data. Durable writes wait
          for immediate commits. Checkpoint and restore use the same context
          note with no references.
        </p>
        <p>
          The memory figure is a post-run snapshot, not peak RSS. This benchmark
          does not measure public HTTPS capacity, isolated maximum throughput,
          distributed swarms or real-model recall quality.
        </p>
        <p>
          <a class="text-link" href="/docs/benchmarks/">
            Full methodology →
          </a>
        </p>
      </section>
    </div>
    <section class="band">
      <p class="eyebrow">
        <b>Lean infrastructure</b> / zero license fee
      </p>
      <h2>Pay for your machine. Keep the software free.</h2>
      <p>
        instantKV is MIT licensed. There is no per-agent, per-key or per-request
        software fee. One Rust process and an embedded database keep the
        deployment small. Your infrastructure, backups and operations still have
        a cost; managed hosting pricing has not been announced.
      </p>
    </section>
    <section class="band">
      <div class="band__head">
        <p class="eyebrow">
          <b>Reproduce it</b>
        </p>
        <h2>Measure your own node.</h2>
      </div>
      <p>
        Use a disposable, default-profile instance. Checkpoint runs retain
        bundles, so keep the suite separate from production memory.
        <a class="text-link" href="/docs/quickstart/">
          Set up first →
        </a>
      </p>
      <pre><code>INSTANTKV_BIN=./scripts/kv.sh ./scripts/benchmark-suite.sh /absolute/results</code></pre>
      <p class="chart-note">
        The suite repeats five workloads three times and writes raw JSON. Keep
        the config, commit, hardware and host load with your results.
      </p>
    </section>
    <section class="raw-runs band">
      <h2>Open the raw results.</h2>
      {workloads.map((w) => (
        <details>
          <summary>{w.name} / 3 raw reports</summary>
          <div class="table-scroll">
            <table>
              <thead>
                <tr>
                  <th>Run</th>
                  <th>Req/s</th>
                  <th>p50 ms</th>
                  <th>p95 ms</th>
                  <th>p99 ms</th>
                  <th>Errors</th>
                  <th>Raw JSON</th>
                </tr>
              </thead>
              <tbody>
                {w.runs.map((r, i) => (
                  <tr>
                    <td>{i + 1}</td>
                    <td>{number(r.successful_requests_per_second)}</td>
                    <td>{r.latency_ms.p50.toFixed(2)}</td>
                    <td>{r.latency_ms.p95.toFixed(2)}</td>
                    <td>{r.latency_ms.p99.toFixed(2)}</td>
                    <td>{r.errors}</td>
                    <td>
                      <a href={`/benchmark-data/${w.id}-${i + 1}.json`}>
                        Download ↗
                      </a>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </details>
      ))}
    </section>
  </main>
  <script>
    const rows = [...document.querySelectorAll<HTMLElement>('.chart-row')];
    document
      .querySelectorAll<HTMLButtonElement>('[data-metric]')
      .forEach((button) => {
        button.addEventListener('click', () => {
          const metric = button.dataset.metric!;
          const values = rows.map((row) => Number(row.dataset[metric]));
          const max = Math.max(...values);
          rows.forEach((row, i) => {
            row.querySelector<HTMLElement>('.chart-bar')!.style.width =
              `${(values[i] / max) * 100}%`;
            row.querySelector('.chart-value')!.textContent =
              metric === 'rps'
                ? `${Math.round(values[i]).toLocaleString('en-US')} req/s`
                : `${values[i].toFixed(2)} ms`;
          });
          document
            .querySelectorAll('[data-metric]')
            .forEach((b) =>
              b.setAttribute('aria-pressed', String(b === button)),
            );
          document.querySelector('#chart-note')!.textContent =
            metric === 'rps'
              ? 'Successful requests/sec · higher is better · median of three run results.'
              : `${metric} latency · lower is better · median of three run percentiles.`;
        });
      });
  </script>
</Base>
