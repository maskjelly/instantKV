---
import Base from '../layouts/Base.astro';
import BenchmarkExplorer from '../components/BenchmarkExplorer.astro';
import QualityEval from '../components/QualityEval.astro';
import { full, mib } from '../lib/evidence';
import { report, workloads, range, recovered } from '../lib/benchmarks';
import '../styles/benchmarks.css';
const save = workloads.find((workload) => workload.id === 'save')!;
const topic = workloads.find((workload) => workload.id === 'topic')!;
---

<Base
  title="Benchmarks"
  description="Compare instantKV retrieval quality, RAM and query speed. Five full datasets, clear engine comparisons, answer accuracy, all resource metrics and raw results."
>
  <main id="main" class="shell benchmark-page" data-pagefind-body>
    <header class="bench-header">
      <p class="bench-kicker">Measured results · 04 October 2026</p>
      <h1>Benchmarks</h1>
      <p>
        Inspect retrieval quality, model answers and storage measurements. Each
        result keeps its workload and comparison limits.
      </p>
      <div class="bench-hostline">
        <span>Apple M4 Pro</span>
        <span>24 GiB RAM</span>
        <span>macOS 27 · ARM64</span>
        <a href="#method">Run conditions ↗</a>
      </div>
    </header>
    <nav class="bench-page-nav" aria-label="Benchmark sections">
      <a href="#overview">Overview</a>
      <a href="#compare">Compare engines</a>
      <a href="#answers">Answer quality</a>
      <a href="#footprint">Storage & speed</a>
      <a href="#method">Method & data</a>
    </nav>
    <BenchmarkExplorer />
    <section id="answers" class="bench-section" aria-labelledby="answers-title">
      <div class="bench-heading">
        <h2 id="answers-title">Answer quality</h2>
        <p>
          A separate test: can a model answer correctly from the retrieved
          memory?
        </p>
      </div>
      <QualityEval />
    </section>
    <section
      id="footprint"
      class="bench-section"
      aria-labelledby="footprint-title"
    >
      <div class="bench-heading">
        <h2 id="footprint-title">Storage & speed</h2>
        <p>
          Separate structured-memory test. Three databases with 10,000 records
          each.
        </p>
      </div>
      <dl class="bench-footprint">
        <div>
          <dt>Recorded Rust binary</dt>
          <dd>
            {mib(report.binary_bytes)} <small>MiB</small>
          </dd>
        </div>
        <div>
          <dt>Durable save · p95</dt>
          <dd>
            {save.p95.toFixed(2)} <small>ms</small>
          </dd>
        </div>
        <div>
          <dt>Topic recall · p95</dt>
          <dd>
            {topic.p95.toFixed(3)} <small>ms</small>
          </dd>
        </div>
        <div>
          <dt>Recovered after restart</dt>
          <dd>
            {recovered.toLocaleString('en-US')} <small>/ 30,000</small>
          </dd>
        </div>
      </dl>
      <p class="bench-note">
        512-byte content plus metadata. Warm loopback HTTP, one request at a
        time, immediate durable commits. No embedding model or cloud API is
        required by the memory engine.
      </p>
      <details class="bench-details">
        <summary>All operation timings and recovery notes</summary>
        <div
          class="bench-comparison-scroll"
          role="region"
          aria-label="Structured-memory operation latency"
          tabindex="0"
        >
          <table class="bench-comparison-table">
            <caption>Milliseconds · median of three run percentiles</caption>
            <thead>
              <tr>
                <th scope="col">Operation</th>
                <th scope="col">p50</th>
                <th scope="col">p95</th>
                <th scope="col">p99</th>
                <th scope="col">p95 range</th>
              </tr>
            </thead>
            <tbody>
              {workloads.map((workload) => (
                <tr>
                  <th scope="row">
                    {workload.name}
                    <small>{workload.detail}</small>
                  </th>
                  <td>{workload.p50.toFixed(3)}</td>
                  <td>{workload.p95.toFixed(3)}</td>
                  <td>{workload.p99.toFixed(3)}</td>
                  <td>{workload.p95Range}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="bench-note">
          Idle RSS{' '}
          {range(
            report.runs.map((run) => run.idle_rss_bytes / 1024 ** 2),
            2,
          )}{' '}
          MiB. All 30,000 records recovered after abrupt process restarts. This
          was not a device power-loss test.
        </p>
        <a
          class="bench-source-link"
          href="/benchmark-data/memory/mac-arm64.json"
        >
          Raw structured-memory runs ↗
        </a>
      </details>
    </section>
    <section id="method" class="bench-section" aria-labelledby="method-title">
      <div class="bench-heading">
        <h2 id="method-title">Method & limits</h2>
        <p>What was measured, what differs, and what is still pending.</p>
      </div>
      <dl class="bench-method">
        <div>
          <dt>Hardware & build</dt>
          <dd>
            Apple M4 Pro, 24 GiB RAM, macOS 27.0 ARM64. Retrieval engine frozen
            at <code>{full.runtime_commit.slice(0, 7)}</code>. No engine tuning
            during the full runs.
          </dd>
        </div>
        <div>
          <dt>Quality scores</dt>
          <dd>
            LongMemEval-S scores source sessions; LoCoMo scores source turns.
            BEIR scores source documents. Recall is not answer accuracy. Small
            score gaps do not establish a significant win.
          </dd>
        </div>
        <div>
          <dt>RAM boundaries</dt>
          <dd>
            instantKV: Rust server only. SQLite: Python runner and in-process
            adapter. Supermemory: server and descendants, including embeddings;
            memory-suite corpus scopes accumulate. Sampled RSS is not peak RAM.
          </dd>
        </div>
        <div>
          <dt>Response speed</dt>
          <dd>
            Memory suites ran under shared host load. BEIR controls are recorded
            same-host runs. Timings do not support isolated speed ratios. CPU
            utilization, CPU time and energy were not recorded.
          </dd>
        </div>
        <div>
          <dt>Supermemory control</dt>
          <dd>
            Local v0.0.8, direct embedding retrieval. Model extraction, query
            rewriting and reranking are disabled. The hosted Supermemory product
            is not measured.
          </dd>
        </div>
        <div>
          <dt>Reproduction</dt>
          <dd>
            Same source data, lossless chunks and questions. SQLite and
            instantKV use matching response pagination bounds. Published
            full-memory rankings were checked with pytrec_eval.{' '}
            <a href="/docs/full-retrieval/">Read the full run notes ↗</a>
          </dd>
        </div>
      </dl>
      <details class="bench-details">
        <summary>Pending benchmarks and device tests</summary>
        <p class="bench-note">
          LongMemEval-V2 Small / Medium, AMA-Bench, BEAM and 100K / 1M / 10M+
          record tests are incomplete. Mem0, Zep and independent dense-vector
          controls are not complete. Competitor end-to-end QA, phone latency,
          battery and native bindings remain pending. No score or resource
          estimate is assigned to an unfinished run.
        </p>
      </details>
      <div class="bench-downloads">
        <a href="/benchmark-data/full-retrieval/summary.json">
          Retrieval summary ↗
        </a>
        <a href="/benchmark-data/full-retrieval/runtime-metrics.json">
          Resource samples ↗
        </a>
        <a href="/benchmark-data/full-retrieval/verification.json">
          Verification ↗
        </a>
        <a href="/docs/benchmarks/">Reproduction guide ↗</a>
        <a href="/docs/evaluation-policy/">Evaluation policy ↗</a>
      </div>
    </section>
  </main>
</Base>
