---
import Base from '../layouts/Base.astro';
interface SuiteReport {
  complete: boolean;
  benchmark: string;
  test_queries: number;
  providers: Record<
    string,
    {
      metrics: Record<string, number>;
      categories: Record<string, { queries: number; recall_at_10: number }>;
      accepted_query_latency_ms: { p95: number } | null;
      largest_sampled_rss_bytes: number;
      contract_rejections: number;
      truncated_queries: number;
      reduced_queries: number;
    }
  >;
}
const suite = Object.entries(
  import.meta.glob<SuiteReport>(
    '../../../docs/benchmarks/2026-10-04-search/default/{nfcorpus,arguana,locomo,longmemeval}.json',
    { eager: true, import: 'default' },
  ),
);
if (suite.length !== 4 || suite.some(([, r]) => !r.complete))
  throw new Error('Retrieval suite must be complete before publication');
const locomo = suite.find(([path]) => path.endsWith('/locomo.json'))?.[1];
import ranked from '../../../docs/benchmarks/2026-10-04-search/scifact.json';
import {
  report,
  workloads,
  range,
  recovered,
  deleted,
  errors,
  largestRss,
} from '../lib/benchmarks';
interface RecordingStats {
  records_per_second: number;
  latency_ms: { p50: number; p99: number };
  iteration: number;
}
const recordings = Object.values(
  import.meta.glob<RecordingStats>(
    '../../../docs/demo-results/2026-10-03-memory/memory-[123].json',
    { eager: true, import: 'default' },
  ),
);
const recording = recordings.sort(
  (a, b) => a.records_per_second - b.records_per_second,
)[1];
const number = (n: number) => Math.round(n).toLocaleString('en-US');
const mib = (n: number) => (n / 1024 ** 2).toFixed(1);
const max = Math.max(...workloads.map((w) => w.p95));
---

<Base
  title="Memory benchmarks"
  description="Fresh measurements of remember, filtered recall, browse, exact reads and forget on the current structured-memory API. Raw samples, resource use and recovery checks included."
>
  <main id="main" class="shell benchmarks-page" data-pagefind-body>
    <header class="page-intro">
      <p class="eyebrow">
        Current memory API / {report.cpu} / {report.runs.length} runs
      </p>
      <h1>Measure the memory layer.</h1>
      <p>
        10,000 structured memories per run. Real durable saves, filtered queries
        and deletes. Local HTTP timings, without model inference.
      </p>
      <p class="u-cluster">
        <a class="text-link" href="/demo/">
          Try the memory tools →
        </a>
        <a class="text-link" href="/benchmark-data/memory/mac-arm64.json">
          Raw report + every sample ↗
        </a>
      </p>
    </header>
    <section class="band">
      <h2>More retrieval workloads</h2>
      <p>
        Frozen default settings. Original queries. Rejections count as misses.
        Supermemory local is the recorded 3 October control, with bge embeddings
        and no extraction, reranking or query rewriting. It was not rerun here.
      </p>
      <div class="table-scroll">
        <table>
          <caption>
            Evidence Recall@10 / local retrieval, without an answer model
          </caption>
          <thead>
            <tr>
              <th scope="col">Workload</th>
              <th scope="col">Queries</th>
              <th scope="col">instantKV</th>
              <th scope="col">Supermemory local</th>
              <th scope="col">Raw results</th>
            </tr>
          </thead>
          <tbody>
            {suite.map(([path, r]) => (
              <tr>
                <th scope="row">{r.benchmark}</th>
                <td>{number(r.test_queries)}</td>
                <td>
                  {(100 * r.providers.instantkv.metrics.recall_at_10).toFixed(
                    2,
                  )}
                  %
                </td>
                <td>
                  {(100 * r.providers.supermemory.metrics.recall_at_10).toFixed(
                    2,
                  )}
                  %
                </td>
                <td>
                  <a
                    href={
                      '/benchmark-data/search-v2/default/' +
                      path.split('/').at(-1)
                    }
                  >
                    JSON ↗
                  </a>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p>
        LoCoMo measures evidence turns from ten histories. LongMemEval-S is a
        fixed twelve-question pilot with full histories and session-level
        evidence. These are not official QA scores.
      </p>
      <p>
        <a class="text-link" href="/blog/lightweight-memory-benchmarks/">
          How it works, costs and next improvements →
        </a>
      </p>
      <div class="table-scroll">
        <table>
          <caption>
            Default-policy cost / p95 includes pagination to retrieve up to 20
            unique sources
          </caption>
          <thead>
            <tr>
              <th scope="col">Workload</th>
              <th scope="col">instantKV accepted p95</th>
              <th scope="col">Supermemory p95</th>
              <th scope="col">Sampled RSS: instantKV / Supermemory</th>
              <th scope="col">instantKV rejected / truncated / reduced</th>
            </tr>
          </thead>
          <tbody>
            {suite.map(([, r]) => (
              <tr>
                <th scope="row">{r.benchmark}</th>
                <td>
                  {r.providers.instantkv.accepted_query_latency_ms?.p95.toFixed(
                    2,
                  )}{' '}
                  ms
                </td>
                <td>
                  {r.providers.supermemory.accepted_query_latency_ms?.p95.toFixed(
                    2,
                  )}{' '}
                  ms
                </td>
                <td>
                  {mib(r.providers.instantkv.largest_sampled_rss_bytes)} /{' '}
                  {mib(r.providers.supermemory.largest_sampled_rss_bytes)} MiB
                </td>
                <td>
                  {r.providers.instantkv.contract_rejections} /{' '}
                  {r.providers.instantkv.truncated_queries} /{' '}
                  {r.providers.instantkv.reduced_queries}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p>
        Long questions select up to 64 original indexed terms. Reduced questions
        have not failed, but the ranking represents a smaller query. Truncated
        searches can miss the complete top-k. Expansion stays off by default.
        <a href="/docs/memory-benchmark-notes/">
          Before/after and expansion results →
        </a>
      </p>
      {locomo && (
        <div class="table-scroll">
          <table>
            <caption>
              LoCoMo evidence-turn Recall@10 by task / both wins and losses
            </caption>
            <thead>
              <tr>
                <th scope="col">Task</th>
                <th scope="col">Questions</th>
                <th scope="col">instantKV</th>
                <th scope="col">Supermemory local</th>
              </tr>
            </thead>
            <tbody>
              {['single-hop', 'multi-hop', 'temporal', 'open-domain'].map(
                (category) => (
                  <tr>
                    <th scope="row">{category}</th>
                    <td>
                      {locomo.providers.instantkv.categories[category].queries}
                    </td>
                    <td>
                      {(
                        100 *
                        locomo.providers.instantkv.categories[category]
                          .recall_at_10
                      ).toFixed(2)}
                      %
                    </td>
                    <td>
                      {(
                        100 *
                        locomo.providers.supermemory.categories[category]
                          .recall_at_10
                      ).toFixed(2)}
                      %
                    </td>
                  </tr>
                ),
              )}
            </tbody>
          </table>
        </div>
      )}
      <p>
        One run per provider and workload; warm local HTTP timings. RSS covers
        each server's process tree and is sampled, not peak. Source text is
        split without discarding text. Duplicate chunks collapse to source IDs.
        No phone, energy or hosted-service measurements.
      </p>
    </section>
    <section class="band">
      <h2>Document recall: instantKV and Supermemory</h2>
      <p>
        BEIR SciFact: 5,183 scientific documents, 300 judged queries, identical
        text and dataset hashes. Fresh databases in sequential same-host runs.
        Supermemory uses local bge-base-en-v1.5 embeddings, no reranking or
        query rewriting.
      </p>
      <div class="table-scroll">
        <table>
          <caption>Tested local configurations / no generation model</caption>
          <thead>
            <tr>
              <th scope="col">Measurement</th>
              <th scope="col">instantKV BM25</th>
              <th scope="col">Supermemory local v0.0.8</th>
            </tr>
          </thead>
          <tbody>
            {[
              [
                'Recall@10',
                ...Object.values(ranked.providers).map(
                  (p) =>
                    (100 * p.scifact.metrics.recall_at_10).toFixed(2) + '%',
                ),
              ],
              [
                'nDCG@10',
                ...Object.values(ranked.providers).map((p) =>
                  p.scifact.metrics.ndcg_at_10.toFixed(4),
                ),
              ],
              [
                'Ranked query p95',
                ...Object.values(ranked.providers).map(
                  (p) => p.scifact.query_latency_ms.p95.toFixed(3) + ' ms',
                ),
              ],
              [
                'Save completion p95',
                ...Object.values(ranked.providers).map(
                  (p) => p.save_latency_ms.p95.toFixed(3) + ' ms',
                ),
              ],
              [
                'Largest sampled RSS',
                ...Object.values(ranked.providers).map(
                  (p) => mib(p.largest_sampled_rss_bytes) + ' MiB',
                ),
              ],
              [
                'Native binary',
                ...Object.values(ranked.providers).map(
                  (p) => mib(p.binary_bytes) + ' MiB',
                ),
              ],
            ].map((row) => (
              <tr>
                <th scope="row">{row[0]}</th>
                <td>{row[1]}</td>
                <td>{row[2]}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p>
        English lexical retrieval, not semantic similarity. Sparse indexing
        raised instantKV document-save p95 from 6.76 to 11.82 ms; the SciFact
        database used 81 MiB. All evaluated queries completed within the default
        work limits. Sampled RSS is not peak RAM.
      </p>
      <p>
        This dataset does not establish general superiority, personal-memory
        quality or phone performance. The separate workload below checks
        existing filters and recovery with ranked indexing enabled.
      </p>
      <p class="u-cluster">
        <a class="text-link" href="/benchmark-data/search/scifact.json">
          Rankings, samples and hashes ↗
        </a>
        <a class="text-link" href="/benchmark-data/search/README.md">
          Method and reproduction ↗
        </a>
      </p>
    </section>
    <div class="instruments" style="--cols:4">
      <div>
        <span class="data-label">Exact restart recovery</span>
        <strong>{number(recovered)}</strong>
        <small>memories / abrupt process exits</small>
      </div>
      <div>
        <span class="data-label">Verified deletion</span>
        <strong>{number(deleted)}</strong>
        <small>records removed from indexes</small>
      </div>
      <div>
        <span class="data-label">Largest sampled RAM</span>
        <strong>{mib(largestRss)} MiB</strong>
        <small>server RSS · not peak RSS</small>
      </div>
      <div>
        <span class="data-label">Failed operations</span>
        <strong>{errors}</strong>
        <small>three measured runs</small>
      </div>
    </div>
    <section class="band">
      <div class="bench-head">
        <h2>Operation latency</h2>
        <div class="chart-controls" role="group" aria-label="Chart percentile">
          <button data-metric="p50" aria-pressed="false">
            p50
          </button>
          <button data-metric="p95" aria-pressed="true">
            p95
          </button>
          <button data-metric="p99" aria-pressed="false">
            p99
          </button>
        </div>
      </div>
      <div class="chart" aria-label="Memory operation latency comparison">
        {workloads.map((w) => (
          <div
            class="chart-row"
            data-p50={w.p50}
            data-p95={w.p95}
            data-p99={w.p99}
          >
            <span>{w.name}</span>
            <div class="chart-bar-track">
              <div
                class="chart-bar"
                style={`width:${(w.p95 / max) * 100}%`}
              ></div>
            </div>
            <span class="chart-value">{w.p95.toFixed(3)} ms</span>
          </div>
        ))}
      </div>
      <p class="chart-note" id="chart-note" aria-live="polite">
        p95 latency · lower is better · median of three run percentiles.
      </p>
      <div class="table-scroll">
        <table>
          <caption>
            All timings in milliseconds / percentiles use each operation's
            actual samples
          </caption>
          <thead>
            <tr>
              <th>Operation</th>
              <th>Samples, total</th>
              <th>p50 median</th>
              <th>p95 range</th>
              <th>p99 median</th>
            </tr>
          </thead>
          <tbody>
            {workloads.map((w) => (
              <tr>
                <td>
                  {w.name}
                  <small>{w.detail}</small>
                </td>
                <td>{number(w.samples)}</td>
                <td>{w.p50.toFixed(3)}</td>
                <td>{w.p95Range}</td>
                <td>{w.p99.toFixed(3)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p>
        p95 is the time within which 95% of measured operations finish. Each
        median uses three run percentiles; samples are not pooled. Sparse
        keyword timing covers one bounded page with no match. Finding the oldest
        matching memory required {report.runs[0].sparse_keyword_pages} pages.
      </p>
    </section>
    <div class="bench-notes">
      <section>
        <h2>The workload</h2>
        <ul>
          <li>
            {report.cpu}; {number(report.hardware_memory_bytes / 1024 ** 3)} GiB
            RAM; {report.machine}.
          </li>
          <li>
            Three fresh local-profile databases. 512-byte content plus topic,
            tag, event time and JSON metadata.
          </li>
          <li>
            20 topics and four tags. Queries return up to 10 memories in 16 KiB.
          </li>
          <li>
            Authenticated loopback HTTP/1.1, keep-alive, concurrency one. 20
            query warmups; 300 timed calls per query workload.
          </li>
          <li>
            Immediate commits stay enabled. Every saved field is checked after
            an abrupt restart.
          </li>
        </ul>
      </section>
      <section>
        <h2>Footprint and scope</h2>
        <ul>
          <li>{mib(report.binary_bytes)} MiB native release binary.</li>
          <li>
            Idle server RSS:{' '}
            {range(
              report.runs.map((r) => r.idle_rss_bytes / 1024 ** 2),
              2,
            )}{' '}
            MiB.
          </li>
          <li>
            Largest sampled RSS: {mib(largestRss)} MiB. Sampling does not
            measure the true peak.
          </li>
          <li>
            Physical database:{' '}
            {range(
              report.runs.map((r) => r.database_bytes / 1024 ** 2),
              1,
            )}{' '}
            MiB.
          </li>
        </ul>
        <p>
          Measured {new Date(report.recorded_at).toISOString().slice(0, 10)}.{' '}
          <a
            href={`https://github.com/maskjelly/instantKV/tree/${report.runtime_source}`}
          >
            Runtime source {report.runtime_source.slice(0, 7)} ↗
          </a>
          . The raw report includes the binary hash and source state.
        </p>
        <p>
          These synthetic warm queries exclude public HTTPS, inference, battery
          use, phones and power-loss recovery.
        </p>
      </section>
    </div>
    <section class="band">
      <p class="eyebrow">Fresh demo recording / same memory API</p>
      <h2>Three durable memory runs. Saved tool responses.</h2>
      <p>
        The recorder saved 10,000 new memories in each run through the current
        memory API. It preserved exact reads, six query types, cursor
        continuation and a deletion receipt. Recorded mode selects the
        median-throughput run.
      </p>
      <div class="instruments" style="--cols:3">
        <div>
          <span class="data-label">Median-throughput run</span>
          <strong>{number(recording.records_per_second)}</strong>
          <small>memories / second</small>
        </div>
        <div>
          <span class="data-label">Save p50 / p99</span>
          <strong>
            {recording.latency_ms.p50.toFixed(2)} /{' '}
            {recording.latency_ms.p99.toFixed(2)}
          </strong>
          <small>ms · coordinator-to-Rust HTTP</small>
        </div>
        <div>
          <span class="data-label">Current API saves</span>
          <strong>30,000</strong>
          <small>three recorded runs · zero errors</small>
        </div>
      </div>
      <p>
        The recorder uses 16 concurrent writes and 512-memory batches. Queued
        commit latency differs from the sequential benchmark above. It uses one
        fresh dedicated database with three sessions. Timing excludes Cloudflare
        and the public network.
      </p>
      <p class="u-cluster">
        <a class="text-link" href="/demo/?source=recorded">
          Inspect saved responses →
        </a>
        <a class="text-link" href="/recordings/memory/README.md">
          Method + three raw runs ↗
        </a>
      </p>
    </section>
    <section class="band">
      <h2>Reproduce the current product.</h2>
      <pre><code>{`cargo build --release --locked -p instantkv
python3 scripts/memory-bench.py --records 10000 --runs 3 --queries 300 \\
  --output /tmp/instantkv-memory-benchmark.json
node demo/record.mjs /tmp/instantkv-memory-recordings`}</code></pre>
      <p>
        The scripts create their own temporary storage and credentials. The
        benchmark measures and verifies recovery. The recorder captures the
        browser demo's tool responses. Neither runs a model.
      </p>
      <a class="text-link" href="/docs/benchmarks/">
        Full methodology →
      </a>
    </section>
    <section class="band">
      <p class="eyebrow">Next device targets / unverified</p>
      <h2>Measure ARM boards, then native phone apps.</h2>
      <p>
        Initial goals on a 4 GiB Linux ARM64 board: indexed recall p95 ≤5 ms,
        durable save p95 ≤20 ms, idle RSS ≤12 MiB and loaded RSS ≤32 MiB with
        10,000 memories. Device measurements, native bindings and battery
        profiling remain planned.
      </p>
      <a
        class="text-link"
        href="/docs/performance/#next-device-targets--not-yet-measured"
      >
        Performance plan ↗
      </a>
    </section>
  </main>
  <script>
    const rows = [...document.querySelectorAll<HTMLElement>('.chart-row')];
    document
      .querySelectorAll<HTMLButtonElement>('[data-metric]')
      .forEach((button) =>
        button.addEventListener('click', () => {
          const metric = button.dataset.metric!;
          const values = rows.map((row) => Number(row.dataset[metric])),
            max = Math.max(...values);
          rows.forEach((row, i) => {
            row.querySelector<HTMLElement>('.chart-bar')!.style.width =
              (values[i] / max) * 100 + '%';
            row.querySelector('.chart-value')!.textContent =
              values[i].toFixed(3) + ' ms';
          });
          document
            .querySelectorAll('[data-metric]')
            .forEach((b) =>
              b.setAttribute('aria-pressed', String(b === button)),
            );
          document.querySelector('#chart-note')!.textContent =
            metric +
            ' latency · lower is better · median of three run percentiles.';
        }),
      );
  </script>
</Base>
