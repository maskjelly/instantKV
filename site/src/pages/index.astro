---
import Base from '../layouts/Base.astro';
import { full, percent, mib } from '../lib/evidence';
import { report } from '../lib/benchmarks';
import { repository } from '../lib/docs';
import '../styles/home.css';
const install = [
  'cargo install --git https://github.com/maskjelly/instantKV --locked instantkv',
  'mkdir my-local-memory',
  'cd my-local-memory',
  'instantkv init',
  'instantkv serve',
].join('\n');
const remember = [
  'instantkv remember "Prefer Rust for local tools" --key preferences/language',
  '  --topic preferences',
].join(' \\' + '\n');
---

<Base
  title="instantKV"
  description="Open-source local AI memory for agents. Install a Rust service with MCP, HTTP, CLI and an embedded core. Structured recall, BM25 search and durable checkpoints."
>
  <main id="main" class="shell service-home" data-pagefind-body>
    <section class="service-hero" aria-labelledby="home-title">
      <div class="service-intro">
        <p class="eyebrow">Open-source agent infrastructure</p>
        <h1 id="home-title">
          Local AI memory
          <br />
          for your agents.
        </h1>
        <p class="service-deck">
          instantKV is an open-source local memory service for AI agents. Store
          facts, preferences and task state. Retrieve them next session.
        </p>
        <div class="hero-actions">
          <a class="button button--key" href="/docs/quickstart/">
            Installation guide <span aria-hidden="true">→</span>
          </a>
          <a class="text-link" href={repository}>
            Read the source ↗
          </a>
        </div>
      </div>
      <div class="install-panel" aria-labelledby="install-title">
        <div class="install-heading">
          <h2 id="install-title">Run it locally</h2>
          <span>Rust 1.98+</span>
        </div>
        <pre><code>{install}</code></pre>
        <p>
          <strong>Source MVP, unreleased.</strong> Published v0.1.2 archives
          contain the earlier KV/checkpoint tools. Build from source for
          structured memory.
        </p>
        <a href="/docs/agents/">Connect your agent through MCP →</a>
      </div>
    </section>
    <dl class="service-facts" aria-label="Service defaults">
      <div>
        <dt>Runs on</dt>
        <dd>Your machine</dd>
      </div>
      <div>
        <dt>Default address</dt>
        <dd>
          <code>127.0.0.1:8080</code>
        </dd>
      </div>
      <div>
        <dt>Local data</dt>
        <dd>
          <code>.instantkv/data</code>
        </dd>
      </div>
      <div>
        <dt>License</dt>
        <dd>MIT</dd>
      </div>
    </dl>
    <section class="service-section" aria-labelledby="workflow-title">
      <header class="section-heading">
        <h2 id="workflow-title">Save once. Find it next session.</h2>
        <p>
          Your app chooses what to save and what to add to context. instantKV
          keeps the records and indexes consistent.
        </p>
      </header>
      <div class="memory-workflow">
        <div class="workflow-code">
          <h3>Save a preference</h3>
          <pre><code>{remember}</code></pre>
          <h3>Retrieve it later</h3>
          <pre><code>instantkv recall --topic preferences</code></pre>
          <p>
            Run these commands in another terminal, from the same memory
            directory. Credentials load automatically.
          </p>
        </div>
        <div class="memory-record">
          <div class="record-heading">
            <h3>What you keep</h3>
            <code>preferences/language</code>
          </div>
          <blockquote>Prefer Rust for local tools</blockquote>
          <dl>
            <div>
              <dt>Topic</dt>
              <dd>preferences</dd>
            </div>
            <div>
              <dt>Also supported</dt>
              <dd>Tags, event time, custom JSON metadata</dd>
            </div>
            <div>
              <dt>Storage</dt>
              <dd>Record and indexes in one redb transaction</dd>
            </div>
          </dl>
          <a class="text-link" href="/docs/memory-mvp/">
            Read the memory contract →
          </a>
        </div>
      </div>
    </section>
    <section class="service-section" aria-labelledby="interfaces-title">
      <header class="section-heading">
        <h2 id="interfaces-title">Use the interface that fits.</h2>
        <p>
          One storage engine. Run it as a local service or embed the Rust core.
        </p>
      </header>
      <div class="interface-list">
        <a href="/docs/agents/">
          <span>MCP</span>
          <div>
            <h3>Connect an agent</h3>
            <p>
              Five memory tools, plus KV and checkpoint tools. Native stdio or
              an HTTP-backed bridge.
            </p>
          </div>
          <span aria-hidden="true">↗</span>
        </a>
        <a href="/docs/cli/">
          <span>CLI</span>
          <div>
            <h3>Work from your terminal</h3>
            <p>
              Remember, recall, search, browse and forget. Inspect health and
              restore task checkpoints.
            </p>
          </div>
          <span aria-hidden="true">↗</span>
        </a>
        <a href="/docs/http/">
          <span>HTTP</span>
          <div>
            <h3>Use a scoped API</h3>
            <p>
              Namespace permissions, revision checks, TTL and bounded requests.
            </p>
          </div>
          <span aria-hidden="true">↗</span>
        </a>
        <a href="/docs/local-first/">
          <span>Rust</span>
          <div>
            <h3>Embed the core</h3>
            <p>
              Use the engine in process. Keep storage and retrieval beside your
              runtime.
            </p>
          </div>
          <span aria-hidden="true">↗</span>
        </a>
      </div>
    </section>
    <section class="service-section" aria-labelledby="boundaries-title">
      <header class="section-heading">
        <h2 id="boundaries-title">Know what you are installing.</h2>
      </header>
      <div class="service-boundaries">
        <div>
          <h3>Local by default</h3>
          <p>
            Private credentials. Loopback binding. Configurable cache, quotas
            and query budgets. Storage and retrieval need no cloud API or
            embedding model.
          </p>
          <a class="text-link" href="/docs/configuration/">
            Configuration →
          </a>
        </div>
        <div>
          <h3>Explicit retrieval</h3>
          <p>
            <code>search</code> uses bounded BM25 with English stemming. Literal
            filters use topics, tags and time. Inspect <code>truncated</code>{' '}
            and <code>query_reduced</code>.
          </p>
          <a class="text-link" href="/docs/memory-mvp/">
            Query limits →
          </a>
        </div>
        <div>
          <h3>Your runtime stays in control</h3>
          <p>
            Your app extracts facts and decides when to restore context. Native
            phone bindings, device benchmarks and real local-agent continuation
            tests remain planned.
          </p>
          <a class="text-link" href="/docs/roadmap/">
            Current scope and roadmap →
          </a>
        </div>
        <div>
          <h3>Operate your own node</h3>
          <p>
            Keep the data directory across upgrades. Back up the database while
            the server is stopped. Logical quotas do not cap total disk or
            process memory.
          </p>
          <a class="text-link" href="/docs/operations/">
            Backups and upgrades →
          </a>
        </div>
      </div>
    </section>
    <section class="service-section" aria-labelledby="evidence-title">
      <header class="section-heading">
        <h2 id="evidence-title">Evidence, with its conditions.</h2>
        <p>
          Published runs measure retrieval, model answers and storage
          separately. Small score gaps do not establish a significant win.
        </p>
      </header>
      <div class="service-evidence">
        <a href="/benchmarks/#memory">
          <strong>
            {percent(full.suites['longmemeval-s'].instantkv.recall_at_10)}
            <small>%</small>
          </strong>
          <span>Source-session Recall@10</span>
          <p>
            All 500 LongMemEval-S questions. Retrieval score, separate from
            answer accuracy.
          </p>
        </a>
        <a href="/benchmarks/#footprint">
          <strong>
            {mib(
              full.suites['longmemeval-s'].instantkv.largest_sampled_rss_bytes,
            )}
            <small> MiB</small>
          </strong>
          <span>Largest sampled server RSS</span>
          <p>
            LongMemEval-S on Apple M4 Pro. Sampled process memory; peak RAM was
            not measured.
          </p>
        </a>
        <a href="/benchmarks/#footprint">
          <strong>
            {mib(report.binary_bytes)}
            <small> MiB</small>
          </strong>
          <span>Recorded native binary</span>
          <p>
            macOS ARM64 release build. Physical ARM-board and phone tests remain
            pending.
          </p>
        </a>
      </div>
      <div class="evidence-links">
        <a class="text-link" href="/benchmarks/">
          Benchmarks and raw data →
        </a>
        <a class="text-link" href="/blog/lightweight-memory-benchmarks/">
          Read the engineering notes →
        </a>
      </div>
    </section>
    <section class="service-next" aria-labelledby="next-title">
      <h2 id="next-title">Make it part of your runtime.</h2>
      <p>
        Start with the local profile. Save a record, connect your agent, and
        check the query limits.
      </p>
      <div class="button-row">
        <a class="button button--key" href="/docs/quickstart/">
          Start locally →
        </a>
        <a class="text-link" href="/docs/contributing/">
          Build with us ↗
        </a>
      </div>
    </section>
  </main>
</Base>
