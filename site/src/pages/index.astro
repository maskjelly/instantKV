---
import Base from '../layouts/Base.astro';
import { repository } from '../lib/docs';
import footprint from '../../../docs/benchmarks/2026-10-03-ranked/mac-arm64.json';
import ranked from '../../../docs/benchmarks/2026-10-03-ranked/scifact.json';
const recallPercent = (
  100 * ranked.providers.instantkv.scifact.metrics.recall_at_10
).toFixed(2);
const mib = (bytes: number) => (bytes / 1024 ** 2).toFixed(1);
const sampledRss = Math.max(
  ...footprint.runs.map((run) => run.largest_sampled_rss_bytes),
);
const topicP95 = Math.max(
  ...footprint.runs.map((run) => run.queries.topic.latency_ms.p95),
);
const save = `instantkv remember "Prefer Rust for local tools" \\
  --key preferences/language \\
  --topic preferences --tag local

instantkv search "preferred language for local tooling"`;
const install = `# From the MVP source checkout:
cargo install --path crates/instantkv --locked

instantkv init
instantkv serve`;
---

<Base
  title="instantKV"
  description="Local-first memory for local LLMs. Save and recall by topic, tag, time or keywords. A small Rust core, configurable budgets and a native mobile roadmap."
>
  <main id="main" class="shell landing" data-pagefind-body>
    <section class="landing-hero">
      <p class="hero-kicker">Local-first. Open source.</p>
      <h1>
        Memory for agents.
        <br />
        <span>On your device.</span>
      </h1>
      <p class="landing-description">
        Save facts, preferences and task state beside your local model. Find
        memories by topic, tag or time. Rank documents with lightweight BM25
        search. Keep them across sessions and server restarts.
      </p>
      <div class="hero-actions">
        <a class="button button--key" href="/demo/">
          Try the memory tools
        </a>
        <a class="hero-source" href={repository}>
          View on GitHub <span aria-hidden="true">↗</span>
        </a>
      </div>
      <p class="hero-meta">
        Rust · HTTP · CLI · MCP <span aria-hidden="true">/</span> Source MVP ·
        MIT
      </p>
    </section>

    <section class="memory-example" aria-labelledby="example-title">
      <header class="example-heading">
        <h2 id="example-title">Remember once. Recall next session.</h2>
        <a href="/docs/cli/">
          CLI reference <span aria-hidden="true">↗</span>
        </a>
      </header>
      <div class="example-columns">
        <div class="example-command">
          <span class="example-label">Your terminal</span>
          <pre><code>{save}</code></pre>
        </div>
        <div class="example-record">
          <span class="example-label">Example memory fields</span>
          <div class="record-location">
            <span>knowledge</span>
            <span aria-hidden="true">/</span>
            <strong>preferences/language</strong>
          </div>
          <pre><code>{`{
  "content": "Prefer Rust for local tools",
  "topic": "preferences",
  "tags": ["local"]
}`}</code></pre>
          <p>
            Each save has an event time. Add your own JSON metadata.
            <a href="/demo/">Try topic, tag and time queries →</a>
          </p>
        </div>
      </div>
    </section>

    <aside class="footprint-strip" aria-label="Measured local footprint">
      <div class="footprint-caption">
        <span>10,000 memories. Three measured Mac runs.</span>
        <a href="/benchmarks/">Current measurements & limits ↗</a>
      </div>
      <dl>
        <div>
          <dt>Native binary</dt>
          <dd>
            {mib(footprint.binary_bytes)} <span>MiB</span>
          </dd>
        </div>
        <div>
          <dt>Largest sampled server RAM</dt>
          <dd>
            {mib(sampledRss)} <span>MiB</span>
          </dd>
        </div>
        <div>
          <dt>Topic query p95, slowest run</dt>
          <dd>
            {topicP95.toFixed(2)} <span>ms</span>
          </dd>
        </div>
      </dl>
    </aside>

    <section class="local-details" aria-labelledby="recall-title">
      <div class="details-intro">
        <h2 id="recall-title">
          Relevant documents.
          <br />
          Small footprint.
        </h2>
        <p>
          Rank content without an embedding model or cloud API. English
          stemming, configurable work limits and atomic storage.
        </p>
        <a class="text-link" href="/benchmarks/">
          Retrieval results and tradeoffs ↗
        </a>
      </div>
      <dl class="memory-features">
        <div>
          <dt>{recallPercent}% document recall@10</dt>
          <dd>
            BEIR SciFact: 5,183 documents, 300 judged queries. Supermemory local
            scored{' '}
            {(
              100 * ranked.providers.supermemory.scifact.metrics.recall_at_10
            ).toFixed(2)}
            % with bge-base embeddings and no reranker in a separate fresh
            same-host run.
          </dd>
        </div>
        <div>
          <dt>
            {ranked.providers.instantkv.scifact.query_latency_ms.p95.toFixed(2)}{' '}
            ms ranked search p95
          </dt>
          <dd>
            One sequential loopback HTTP run on an Apple M4 Pro. This measures
            document retrieval. Real-agent quality and phone performance remain
            unverified.
          </dd>
        </div>
      </dl>
    </section>

    <section class="local-details" aria-labelledby="details-title">
      <div class="details-intro">
        <h2 id="details-title">
          Add memory to
          <br />
          your runtime.
        </h2>
        <p>
          Use your existing agent runtime. Store and retrieve records without a
          separate database service, embedding model or cloud API.
        </p>
        <a class="text-link" href="/docs/features/">
          Explore the features ↗
        </a>
      </div>
      <dl class="memory-features">
        <div>
          <dt>Persistent facts</dt>
          <dd>
            Remember content with a topic, tags, event time and your own JSON
            metadata. Retrieve with small, bounded pages.
          </dd>
        </div>
        <div>
          <dt>Checkpoints for unfinished work</dt>
          <dd>
            Save the goal and next action before context clears. Restore the
            checkpoint when the agent returns.
          </dd>
        </div>
        <div>
          <dt>Configurable and extensible</dt>
          <dd>
            Configure namespaces, permissions and budgets. Call the Rust core in
            process or connect your runtime through HTTP and typed tools.
          </dd>
        </div>
      </dl>
    </section>

    <section class="local-install" aria-labelledby="install-title">
      <div>
        <p class="section-kicker">Start locally</p>
        <h2 id="install-title">
          One binary.
          <br />
          Local storage.
        </h2>
        <p>
          Install once. Then save and recall memory offline. Setup creates your
          configuration and private credentials.
        </p>
        <a class="text-link" href="/docs/quickstart/">
          Installation guide ↗
        </a>
      </div>
      <div class="install-command">
        <pre><code>{install}</code></pre>
        <p>
          The source MVP is unreleased. Build with Rust 1.98 or later. Older
          release archives contain only the original KV and checkpoint APIs.
        </p>
      </div>
    </section>
    <section
      class="local-details direction-section"
      aria-labelledby="direction-title"
    >
      <div class="details-intro">
        <p class="section-kicker">Where we are going</p>
        <h2 id="direction-title">
          Local memory today.
          <br />
          Phone support next.
        </h2>
        <p>
          Apps can embed the Rust core. Agents can add custom metadata. Native
          phone integration and real-model evaluation are the next priorities.
        </p>
        <a class="text-link" href="/docs/roadmap/">
          Roadmap & acceptance gates ↗
        </a>
      </div>
      <dl class="memory-features">
        <div>
          <dt>Working in source</dt>
          <dd>
            Four tools save, find, list and delete memories. Ordered indexes
            support topic, tag and time filters. Queries have scan and response
            limits.
          </dd>
        </div>
        <div>
          <dt>Next: real apps and devices</dt>
          <dd>
            Evaluate recall with a real local model. Add Swift/Kotlin bindings.
            Test phone storage, app lifecycle and battery use.
          </dd>
        </div>
        <div>
          <dt>ARM-board performance goals</dt>
          <dd>
            Initial goals: indexed recall p95 ≤5 ms and loaded server RSS ≤32
            MiB with 10,000 memories. These device targets are unverified.{' '}
            <a href="/docs/performance/#next-device-targets--not-yet-measured">
              Read the performance plan ↗
            </a>
          </dd>
        </div>
      </dl>
    </section>
    <div class="landing-bottom">
      <p>
        CI passed on Linux x86_64, Linux ARM64 and macOS ARM64. Physical
        ARM-board measurements and native phone support remain pending.
      </p>
      <a href="/docs/local-first/">Device support ↗</a>
    </div>
  </main>
</Base>
