---
import Base from '../layouts/Base.astro';
import { workloads } from '../lib/benchmarks';
const reads = workloads.find((w) => w.id === 'knowledge-get')!;
const command = `git clone https://github.com/maskjelly/instantKV.git
cd instantKV
INSTANTKV_PROFILE=swarm ./scripts/quickstart.sh

./scripts/kv.sh put shared project/stack \\
  --value '{"content":"Rust + redb"}'
./scripts/kv.sh get shared project/stack
./scripts/kv.sh demo --swarm`;
---

<Base
  title="instantKV"
  description="Keep your agent's work through compaction and restarts. A self-hosted Rust memory service with shared project facts, private notes and durable checkpoints."
>
  <main id="main" class="container" data-pagefind-body>
    <section class="hero">
      <div>
        <span class="eyebrow">Self-hosted agent memory / written in Rust</span>
        <h1>
          Memory your
          <br />
          agents <span class="chrome-text">keep.</span>
        </h1>
        <p>
          Keep the decisions, findings and next step outside your agent's
          context. When it compacts or restarts, load the checkpoint and carry
          on.
        </p>
        <div class="button-row">
          <a class="button button-primary" href="/docs/quickstart/">
            Start self-hosting <span>↗</span>
          </a>
          <a class="button" href="/demo/">
            Try the memory demo <span>→</span>
          </a>
        </div>
        <div class="hero-meta">
          <span>One Rust binary</span>
          <span>HTTP / CLI / MCP</span>
          <span>MIT licensed</span>
        </div>
      </div>
      <div
        class="core-visual"
        aria-label="One memory core, shared knowledge base and private Alpha and Beta namespaces"
      >
        <div class="visual-label">
          <span>01 / MEMORY CORE</span>
          <span>SINGLE NODE</span>
        </div>
        <img
          class="core-mark"
          src="/assets/logo.svg"
          width="205"
          height="205"
          alt="instantKV split chrome K"
        />
        <div>
          <div class="visual-scopes">
            <span>KNOWLEDGE / SHARED</span>
            <span>ALPHA / PRIVATE</span>
            <span>BETA / PRIVATE</span>
          </div>
          <div class="visual-caption">
            <span>
              <span class="signal"></span>DURABLE KNOWLEDGE
            </span>
            <span>SCOPED ACCESS</span>
          </div>
        </div>
      </div>
    </section>
    <section class="stats" aria-label="Measured performance and software cost">
      <div class="stat">
        <span class="stat-value">
          {Math.round(reads.rps).toLocaleString('en-US')}
          <small style="font-size:16px;letter-spacing:0"> /s</small>
        </span>
        <p class="stat-label">Knowledge reads</p>
        <span class="stat-note">Median of 3 runs · loopback HTTP</span>
      </div>
      <div class="stat">
        <span class="stat-value">
          10.3 <small style="font-size:16px;letter-spacing:0">MiB</small>
        </span>
        <p class="stat-label">Observed container memory</p>
        <span class="stat-note">Post-run snapshot · not peak RSS</span>
      </div>
      <div class="stat">
        <span class="stat-value">$0</span>
        <p class="stat-label">Software license cost</p>
        <span class="stat-note">Self-host on your own infrastructure</span>
      </div>
    </section>
    <p class="chart-note stats-citation">
      Measured on a shared 4-vCPU VPS.{' '}
      <a class="text-link" href="/benchmarks/">
        Workloads, conditions and raw results →
      </a>
    </p>
    <section class="demo-teaser">
      <div>
        <span class="eyebrow">Recorded Mac + live VPS / no account needed</span>
        <h2>100,000 memories. Watch them come back.</h2>
        <p>
          Replay actual Mac measurements with cached storage responses, or
          switch to live writes and recall any saved key. Timings stay measured;
          accelerated playback is labeled.
        </p>
      </div>
      <a class="button button-primary" href="/demo/">
        Open the memory demo →
      </a>
    </section>
    <section class="section">
      <div class="section-heading">
        <div>
          <span class="eyebrow">01 / Continuity</span>
          <h2>
            Compact the context.
            <br />
            Keep the work.
          </h2>
        </div>
        <p>
          A checkpoint holds the goal and next step. Keep the details in
          separate records and load them when the agent needs them.
        </p>
      </div>
      <div class="flow">
        <article>
          <span class="number">01 / STORE</span>
          <h3>Save what matters.</h3>
          <p>Facts, decisions and sources under descriptive keys.</p>
        </article>
        <article>
          <span class="number">02 / CHECKPOINT</span>
          <h3>Save the next step.</h3>
          <p>
            Goal, constraints and unfinished work, saved in one transaction.
          </p>
        </article>
        <article>
          <span class="number">03 / COMPACT</span>
          <h3>Free the context.</h3>
          <p>Wait until the save succeeds. Keep its ID outside the prompt.</p>
        </article>
        <article>
          <span class="number">04 / RESTORE</span>
          <h3>Carry on.</h3>
          <p>Load the checkpoint, fetch the details and pick up the task.</p>
        </article>
      </div>
      <p style="font-size:12px;margin-top:20px">
        Connect through{' '}
        <a class="text-link" href="/docs/agents/">
          seven typed MCP tools
        </a>
        . Your runtime chooses when to checkpoint and restore.
      </p>
    </section>
    <section class="section">
      <div class="section-heading">
        <div>
          <span class="eyebrow">02 / Cloud agents & swarms</span>
          <h2>
            One shared base.
            <br />A memory for each worker.
          </h2>
        </div>
        <a class="text-link" href="/docs/cloud-agents/">
          Set up a swarm →
        </a>
      </div>
      <p style="max-width:650px">
        Give your agents the same project knowledge, then let them work
        independently. Each worker gets its own credentials and a private place
        for notes and checkpoints.
      </p>
      <a
        class="diagram-frame"
        href="/assets/swarm.png"
        aria-label="Open full-size swarm architecture diagram"
      >
        <img
          src="/assets/swarm.png"
          width="1600"
          height="1090"
          loading="lazy"
          alt="Operator publishes shared knowledge. Alpha and Beta read it and write their own private knowledge and checkpoint namespaces."
        />
      </a>
      <p class="diagram-caption">
        Working today on one server. Physical replication and automatic
        knowledge consolidation are on the{' '}
        <a class="text-link" href="/docs/distributed-memory/">
          roadmap
        </a>
        .
      </p>
    </section>
    <section class="section">
      <div class="section-heading">
        <div>
          <span class="eyebrow">03 / Built lean</span>
          <h2>
            Small footprint.
            <br />
            One Rust binary.
          </h2>
        </div>
        <p>
          No external database service to run. One binary, one config and one
          data directory.
        </p>
      </div>
      <div class="feature-grid">
        <article class="feature">
          <span class="eyebrow">DURABLE / TRANSACTIONAL</span>
          <h3>Saved before we say so.</h3>
          <p>
            Durable writes succeed after the database commits. Saving a
            checkpoint also updates the session's latest checkpoint in that same
            transaction.
          </p>
        </article>
        <article class="feature">
          <span class="eyebrow">BOUNDED / PREDICTABLE</span>
          <h3>Memory with a budget.</h3>
          <p>
            Set limits on stored records, request sizes and how much context a
            restore returns. Use expiring RAM storage for disposable notes.
          </p>
        </article>
        <article class="feature">
          <span class="eyebrow">SIMPLE / OPEN</span>
          <h3>Your infrastructure. Your rules.</h3>
          <p>
            MIT-licensed Rust. Docker or a native binary. No per-agent software
            fee. You cover the machine, storage and operations.
          </p>
        </article>
        <article class="feature">
          <span class="eyebrow">EXACT / VERSIONED</span>
          <h3>Get the record you saved.</h3>
          <p>
            Read by key, browse by prefix and check revisions before updating a
            record. A restore tells you if a referenced fact changed or went
            missing. Storage and retrieval need no model calls.
          </p>
        </article>
      </div>
      <p style="max-width:650px;margin-top:24px">
        Built for coding agents, remote workers and swarms that need to keep
        their work. You choose what gets saved; instantKV stores it and gives it
        back by key.{' '}
        <a class="text-link" href="/docs/choosing-instantkv/">
          Compare memory tools →
        </a>
      </p>
    </section>
    <section class="section">
      <div class="start-panel">
        <div>
          <span class="eyebrow">04 / Run your node</span>
          <h2>
            Your agents need
            <br />a place to remember.
          </h2>
          <p>
            Start a shared knowledge base and two private workers with Docker
            Compose. The demo checks each worker's permissions, clears its
            context, kills the server and loads the saved checkpoint after a
            real restart.
          </p>
          <a class="text-link" href="/docs/quickstart/">
            Full setup guide →
          </a>
          <p class="version-tag" style="margin-top:24px">
            EARLY RELEASE 0.1.2 / SELF-HOST AVAILABLE
          </p>
        </div>
        <pre><code>{command}</code></pre>
      </div>
    </section>
  </main>
</Base>
