---
import Base from '../layouts/Base.astro';
import MemoryBlueprint from '../components/MemoryBlueprint.astro';
import SwarmDiagram from '../components/diagrams/SwarmDiagram.astro';
import mac from '../../../docs/demo-results/2026-10-02-mac/cache-2.json';
const command = `git clone https://github.com/maskjelly/instantKV.git
cd instantKV
./scripts/quickstart.sh

./scripts/kv.sh put knowledge project/stack \\
  --value '{"content":"Rust + redb"}'
./scripts/kv.sh get knowledge project/stack`;
const steps = [
  {
    name: 'Save the useful parts.',
    text: 'Store decisions, findings and sources under keys your agent can look up.',
  },
  {
    name: 'Checkpoint the work.',
    text: 'Save the goal, constraints and next step before the runtime clears its context.',
  },
  {
    name: 'Pick up where it left off.',
    text: 'Restore the checkpoint. Read the details by key. Carry on with the task.',
  },
];
---

<Base
  title="instantKV"
  description="A fast, self-hosted key-value memory service for AI agents. Durable checkpoints, shared knowledge and private worker memory. Rust. MIT licensed."
>
  <main id="main" class="shell product-page" data-pagefind-body>
    <section class="product-hero">
      <div class="product-hero-copy">
        <p class="eyebrow">Key-value memory / self-hosted</p>
        <h1>
          Fast memory.
          <br />
          For your agents.
        </h1>
        <p class="hero-description">
          Save knowledge outside the context window. Restore it after
          compaction. Run the service on your own machine.
        </p>
        <div class="button-row">
          <a class="button button--key" href="/docs/quickstart/">
            Run instantKV <span aria-hidden="true">↗</span>
          </a>
          <a class="text-link" href="/demo/">
            See the demo →
          </a>
        </div>
      </div>
      <MemoryBlueprint />
    </section>
    <div class="service-spec" aria-label="Service specification">
      <span>Written in Rust</span>
      <span>HTTP · CLI · MCP</span>
      <span>RAM + durable redb</span>
      <span>MIT licensed</span>
    </div>
    <section class="performance-sheet" aria-label="Measured performance">
      <div class="performance-cell">
        <strong>
          {Math.round(mac.records_per_second).toLocaleString('en-US')}
          <small>/s</small>
        </strong>
        <span>RAM cache writes</span>
      </div>
      <div class="performance-cell">
        <strong>
          {mac.latency_ms.p50.toFixed(3)}
          <small>ms</small>
        </strong>
        <span>Backend HTTP PUT p50</span>
      </div>
      <div class="performance-cell">
        <strong>$0</strong>
        <span>Software license fee</span>
      </div>
      <p class="performance-source">
        M4 Pro · 100,000 records · median throughput run of three · local HTTP.{' '}
        <a href="/benchmarks/">Conditions & raw results →</a>
      </p>
    </section>
    <section class="product-section" id="memory">
      <div class="section-heading">
        <h2>
          Keep the work.
          <br />
          Clear the context.
        </h2>
        <p>
          Your runtime decides what to save and when to restore it. instantKV
          gives that memory a reliable place to live.
        </p>
      </div>
      <div class="workflow">
        {steps.map((step, i) => (
          <article>
            <span class="step-number">{String(i + 1).padStart(2, '0')}</span>
            <h3>{step.name}</h3>
            <p>{step.text}</p>
          </article>
        ))}
      </div>
      <a class="text-link" href="/docs/agent-memory/">
        The save and restore workflow →
      </a>
    </section>
    <section class="product-section" id="setup">
      <div class="setup-layout">
        <div>
          <h2>
            A service you run.
            <br />A small stack to manage.
          </h2>
          <p>
            One Rust process. An embedded database. No model calls needed to
            store or retrieve a record.
          </p>
          <dl class="service-details">
            <div>
              <dt>Deploy</dt>
              <dd>Docker Compose or a native binary</dd>
            </div>
            <div>
              <dt>Keep</dt>
              <dd>Durable records and immutable checkpoints</dd>
            </div>
            <div>
              <dt>Bound</dt>
              <dd>Memory, record sizes, expiry and restore context</dd>
            </div>
            <div>
              <dt>Connect</dt>
              <dd>HTTP, CLI or seven typed MCP tools</dd>
            </div>
          </dl>
          <a class="text-link" href="/docs/quickstart/">
            Installation & first record →
          </a>
        </div>
        <div class="setup-specimen">
          <div class="specimen-heading">
            <span>Terminal / Docker quick start</span>
            <span>Copy & run</span>
          </div>
          <pre><code>{command}</code></pre>
          <p>
            Requires Docker. Setup creates private credentials and a persistent
            volume. Your machine and operations are your costs.
          </p>
        </div>
      </div>
    </section>
    <section class="product-section" id="cloud-agents">
      <div class="section-heading">
        <h2>
          Shared knowledge.
          <br />
          Independent workers.
        </h2>
        <p>
          Publish project facts once. Give each cloud agent its own notes,
          checkpoints and scoped credentials.
        </p>
      </div>
      <SwarmDiagram />
      <div class="section-footnote">
        <p>
          Works today on one server. Workers read shared knowledge and write
          only to their own namespaces.
        </p>
        <a class="text-link" href="/docs/cloud-agents/">
          Set up worker scopes →
        </a>
      </div>
    </section>
    <section class="demo-callout">
      <div>
        <h2>
          100,000 memories.
          <br />
          One exact recall.
        </h2>
        <p>
          Replay real Mac measurements with cached responses, or switch to live
          writes on the demo server.
        </p>
      </div>
      <div class="demo-callout-action">
        <a class="button button--key" href="/demo/">
          Open the memory demo →
        </a>
        <span>Recorded playback is labeled. Measurements stay unchanged.</span>
      </div>
    </section>
    <section class="product-section roadmap-section">
      <div>
        <h2>Next: memory that branches.</h2>
        <p>
          Start agents from past snapshots. Let them explore separately, share
          reviewed findings and follow updates from other workers.
        </p>
        <a class="text-link" href="/docs/distributed-memory/">
          Read the distributed memory proposal →
        </a>
      </div>
      <p class="roadmap-note">
        Planned work
        <br />
        <span>Historical branches · continuous updates · peer awareness</span>
      </p>
    </section>
    <section class="resource-links" aria-label="Product resources">
      <a href="/docs/features/">
        <span>Service reference</span>
        <strong>Features & limits ↗</strong>
      </a>
      <a href="/docs/choosing-instantkv/">
        <span>Find the right fit</span>
        <strong>Compare memory tools ↗</strong>
      </a>
      <a href="/docs/contributing/">
        <span>Build with us</span>
        <strong>Contribute to instantKV ↗</strong>
      </a>
    </section>
  </main>
</Base>
