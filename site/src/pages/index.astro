---
import Base from '../layouts/Base.astro';
import EvidenceChart from '../components/EvidenceChart.astro';
import MemoryFlow from '../components/MemoryFlow.astro';
import { memoryEvidence, full, percent, mib } from '../lib/evidence';
import { report } from '../lib/benchmarks';
import { repository } from '../lib/docs';
const install = `cargo install --path crates/instantkv --locked
instantkv init
instantkv serve`;
const memory = `instantkv remember "Prefer Rust for local tools" \\
  --key preferences/language --topic preferences --tag local

instantkv search "preferred language for local tooling"
instantkv recall --topic preferences
instantkv browse --limit 10`;
---

<Base
  title="instantKV"
  description="Persistent local memory for AI agents. A small Rust engine with structured recall, bounded BM25 search and full, independently checked retrieval results."
>
  <main id="main" class="shell refresh-home" data-pagefind-body>
    <section class="editorial-hero">
      <div class="hero-copy">
        <p class="eyebrow">Local-first memory / Rust / MIT</p>
        <h1>
          Small engine.
          <br />
          Lasting memory.
        </h1>
        <p class="hero-deck">
          Give your agent a place to keep facts, preferences and task state.
          Retrieve them next session. Keep the data on your device.
        </p>
        <div class="hero-actions">
          <a class="button button--key" href="/docs/quickstart/">
            Start locally <span aria-hidden="true">→</span>
          </a>
          <a class="hero-source" href={repository}>
            Read the source ↗
          </a>
        </div>
        <p class="hero-meta">
          Rust core · HTTP · CLI · MCP
          <br />
          Source MVP, unreleased. Native phone integration is planned.
        </p>
      </div>
      <figure class="hero-photo">
        <img
          src="/assets/local-devices-hero.webp"
          width="1400"
          height="788"
          alt="Illustration of a compact desktop computer and a phone on a quiet desk"
          fetchpriority="high"
        />
        <figcaption>
          Designed for local compute. Device imagery; phone support is planned.
        </figcaption>
      </figure>
    </section>
    <section class="proof-row" aria-label="Measured evidence">
      <a href="/benchmarks/#memory">
        <span>LongMemEval-S · 500 questions</span>
        <strong>
          {percent(full.suites['longmemeval-s'].instantkv.recall_at_10)}
          <small>%</small>
        </strong>
        <span>Source-session Recall@10</span>
      </a>
      <a href="/benchmarks/#footprint">
        <span>LongMemEval-S · native server</span>
        <strong>
          {mib(
            full.suites['longmemeval-s'].instantkv.largest_sampled_rss_bytes,
          )}
          <small> MiB</small>
        </strong>
        <span>Largest sampled RSS on Mac</span>
      </a>
      <a href="/benchmarks/#footprint">
        <span>Measured macOS ARM64 build</span>
        <strong>
          {mib(report.binary_bytes)}
          <small> MiB</small>
        </strong>
        <span>One native binary</span>
      </a>
    </section>
    <section class="editorial-section" aria-labelledby="how-title">
      <div class="section-heading">
        <p class="eyebrow">01 / Built to sit beside your model</p>
        <h2 id="how-title">
          Your runtime thinks.
          <br />
          instantKV remembers.
        </h2>
        <p>
          The agent decides what matters. The engine stores it, applies your
          limits and retrieves useful records. Storage and retrieval need no
          embedding model or cloud API.
        </p>
      </div>
      <MemoryFlow />
      <div class="feature-columns">
        <div>
          <h3>Save structured memory</h3>
          <p>
            Content, topic, tags, event time and your own JSON metadata. Keep
            facts and checkpoints in private namespaces.
          </p>
        </div>
        <div>
          <h3>Find it with bounded work</h3>
          <p>
            Use ordered filters or BM25 ranking with English stemming. Set
            limits for candidates, bytes, index work and storage.
          </p>
        </div>
        <div>
          <h3>Keep the pieces consistent</h3>
          <p>
            Writes, deletion and expiry update records and indexes in one redb
            transaction. Restore durable memory after a restart.
          </p>
        </div>
      </div>
    </section>
    <section class="editorial-section" aria-labelledby="evidence-title">
      <div class="section-heading">
        <p class="eyebrow">02 / Measured, then checked</p>
        <h2 id="evidence-title">
          Full questions.
          <br />
          Inspectable results.
        </h2>
        <p>
          All 500 LongMemEval-S questions. All ten LoCoMo histories. Five
          ranking files independently checked against official source labels.
        </p>
        <a href="/benchmarks/" class="text-link">
          See every result and comparison limit ↗
        </a>
      </div>
      <EvidenceChart
        rows={memoryEvidence}
        id="home-evidence"
        title="Finding the source evidence"
      />
      <p class="evidence-caveat">
        Retrieval scores, not end-to-end answer accuracy. Local Supermemory uses
        its direct embedding path. Full hosted-product performance is not
        measured.
      </p>
    </section>
    <section
      class="editorial-section start-section"
      aria-labelledby="start-title"
    >
      <div>
        <p class="eyebrow">03 / A small, hackable core</p>
        <h2 id="start-title">Start with three commands.</h2>
        <p>
          Build the source MVP with Rust 1.98 or later. Setup creates private
          credentials; the server binds to loopback.
        </p>
        <pre><code>{install}</code></pre>
        <a href="/docs/agents/" class="text-link">
          Connect your agent through MCP →
        </a>
      </div>
      <div class="terminal-example">
        <span class="eyebrow">Save, rank, filter, inspect</span>
        <pre><code>{memory}</code></pre>
        <p>
          Five memory tools: remember, recall, search, browse and forget. Embed
          the Rust core to use it without HTTP.
        </p>
        <a href="/docs/memory-mvp/">Read the API and query limits ↗</a>
      </div>
    </section>
    <section
      class="editorial-section future-section"
      aria-labelledby="next-title"
    >
      <div class="section-heading">
        <p class="eyebrow">04 / Where we go next</p>
        <h2 id="next-title">
          Quality first.
          <br />
          Local by design.
        </h2>
        <p>
          Better paraphrase recall, reliable multi-hop retrieval, native mobile
          integration and real device tests. Each step must earn its CPU, RAM
          and storage cost.
        </p>
        <a href="/docs/roadmap/" class="text-link">
          Read the roadmap →
        </a>
      </div>
      <div class="photo-pair">
        <figure>
          <img
            src="/assets/local-storage.webp"
            width="1400"
            height="788"
            loading="lazy"
            alt="Conceptual image of a small local solid state drive"
          />
          <figcaption>Persistent local storage. Concept image.</figcaption>
        </figure>
        <figure>
          <img
            src="/assets/arm-board.webp"
            width="1400"
            height="788"
            loading="lazy"
            alt="Conceptual image of a small ARM board"
          />
          <figcaption>
            ARM boards and phones: device tests still ahead.
          </figcaption>
        </figure>
      </div>
    </section>
  </main>
</Base>
