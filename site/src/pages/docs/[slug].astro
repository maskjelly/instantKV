---
import { getEntry, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { docs, groups, repository } from '../../lib/docs';
import SwarmDiagram from '../../components/diagrams/SwarmDiagram.astro';
import LifecycleDiagram from '../../components/diagrams/LifecycleDiagram.astro';
import ArchitectureDiagram from '../../components/diagrams/ArchitectureDiagram.astro';
import ConsolidationDiagram from '../../components/diagrams/ConsolidationDiagram.astro';
import DemoFlowDiagram from '../../components/diagrams/DemoFlowDiagram.astro';

export function getStaticPaths() {
  return docs.map((doc) => ({ params: { slug: doc.slug }, props: { doc } }));
}
const { doc } = Astro.props;
const entry = await getEntry('guides', doc.slug);
if (!entry) throw new Error(`Missing documentation source: ${doc.source}`);
const { Content, headings } = await render(entry);

/* Each guide that has a topology to explain gets the real diagram,
   not a picture of one. */
const slug = doc.slug;
---

<Base title={doc.title} description={doc.description}>
  <main id="main" class="shell docs-layout">
    <aside class="docs-sidebar" aria-label="Documentation navigation">
      <a class="docs-search-link" href="/search/">
        Search documentation <span aria-hidden="true">↗</span>
      </a>
      {groups.map((group) => (
        <section>
          <h2>{group}</h2>
          {docs
            .filter((d) => d.group === group)
            .map((d) => (
              <a
                href={`/docs/${d.slug}/`}
                aria-current={doc.slug === d.slug ? 'page' : undefined}
              >
                {d.title}
              </a>
            ))}
        </section>
      ))}
    </aside>

    <article data-pagefind-body>
      <details class="mobile-docs-nav">
        <summary>Documentation menu / search</summary>
        <a href="/search/">Search documentation →</a>
        {docs.map((d) => (
          <a href={`/docs/${d.slug}/`}>{d.title}</a>
        ))}
      </details>

      <header class="docs-title">
        <p class="data-label">{doc.group} / single-node 0.1.2</p>
        <h1>{doc.title}</h1>
        <p>{doc.description}</p>
      </header>

      {[
        'cloud-agents',
        'live-demo',
        'architecture',
        'distributed-memory',
        'agents',
        'agent-memory',
      ].includes(slug) && (
        <p class="diagram-guide">Diagram / scroll across to inspect details</p>
      )}
      {(slug === 'cloud-agents' && <SwarmDiagram />) ||
        (slug === 'live-demo' && <DemoFlowDiagram />) ||
        (slug === 'architecture' && <ArchitectureDiagram />) ||
        (slug === 'distributed-memory' && <ConsolidationDiagram />) ||
        (slug === 'agents' && <LifecycleDiagram />) ||
        (slug === 'agent-memory' && <LifecycleDiagram />)}

      <div class="prose">
        <Content />
      </div>

      <div class="docs-bottom">
        <a class="text-link" href={`${repository}/blob/main/${doc.source}`}>
          Edit this page on GitHub ↗
        </a>
        <a href="/docs/contributing/">Contribution guide →</a>
      </div>
    </article>

    <aside class="docs-toc" aria-label="On this page">
      <h2>ON THIS PAGE</h2>
      {headings
        .filter((h) => h.depth === 2)
        .map((h) => (
          <a href={`#${h.slug}`}>{h.text}</a>
        ))}
    </aside>
  </main>
</Base>
