---
import { getEntry, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { docs, groups, repository } from '../../lib/docs';
export function getStaticPaths() {
  return docs.map((doc) => ({ params: { slug: doc.slug }, props: { doc } }));
}
const { doc } = Astro.props;
const entry = await getEntry('guides', doc.slug);
if (!entry) throw new Error(`Missing documentation source: ${doc.source}`);
const { Content, headings } = await render(entry);
---

<Base title={doc.title} description={doc.description}>
  <main id="main" class="container docs-layout">
    <aside class="docs-sidebar" aria-label="Documentation navigation">
      <a class="docs-search-link" href="/search/">
        Search documentation <span>↗</span>
      </a>
      {groups.map((group) => (
        <section>
          <h2>{group}</h2>
          {docs
            .filter((d) => d.group === group)
            .map((d) => (
              <a
                href={`/docs/${d.slug}/`}
                aria-current={doc.slug === d.slug ? 'page' : undefined}
              >
                {d.title}
              </a>
            ))}
        </section>
      ))}
    </aside>
    <article data-pagefind-body>
      <details class="mobile-docs-nav">
        <summary>Documentation menu / search</summary>
        <a href="/search/">Search documentation →</a>
        {docs.map((d) => (
          <a href={`/docs/${d.slug}/`}>{d.title}</a>
        ))}
      </details>
      <header class="docs-title">
        <span class="eyebrow">{doc.group} / single-node 0.1.1</span>
        <h1>{doc.title}</h1>
        <p>{doc.description}</p>
      </header>
      <div class="prose">
        <Content />
      </div>
      <div class="docs-bottom">
        <a class="text-link" href={`${repository}/blob/main/${doc.source}`}>
          Edit this page on GitHub ↗
        </a>
        <a href="/docs/contributing/">Contribution guide →</a>
      </div>
    </article>
    <aside class="docs-toc" aria-label="On this page">
      <h2>ON THIS PAGE</h2>
      {headings
        .filter((h) => h.depth === 2)
        .map((h) => (
          <a href={`#${h.slug}`}>{h.text}</a>
        ))}
    </aside>
  </main>
</Base>
