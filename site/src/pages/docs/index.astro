---
import Base from '../../layouts/Base.astro';
import { docs, groups } from '../../lib/docs';
---

<Base
  title="Documentation"
  description="Set up instantKV, connect agents, use every implemented feature and contribute to the Rust memory service."
>
  <main id="main" class="shell" data-pagefind-body>
    <header class="page-intro">
      <p class="eyebrow">
        <b>Documentation</b> / single-node · source MVP
      </p>
      <h1>Documentation</h1>
      <p>
        Install the service, save your first record and connect an agent. The
        guides cover checkpoints, worker permissions and running your own
        server.
      </p>
      <div class="button-row">
        <a class="button button--key" href="/docs/quickstart/">
          Quick start →
        </a>
        <a class="button" href="/search/">
          Search docs
        </a>
      </div>
    </header>
    <nav class="doc-tasks" aria-label="Common documentation tasks">
      <a href="/docs/agents/">Connect an agent</a>
      <a href="/docs/memory-mvp/">Use memory tools</a>
      <a href="/docs/operations/">Back up a node</a>
      <a href="/docs/repository/">Maintain the repo</a>
    </nav>
    <div class="doc-index">
      {groups.map((group) => (
        <section class="doc-index-group">
          <h2>{group}</h2>
          <div class="doc-index-links">
            {docs
              .filter((doc) => doc.group === group)
              .map((doc) => (
                <a href={`/docs/${doc.slug}/`}>
                  <strong>{doc.title}</strong>
                  <span>{doc.description}</span>
                </a>
              ))}
          </div>
        </section>
      ))}
    </div>
  </main>
</Base>
