---
import { repository } from '../lib/docs';
const path = Astro.url.pathname;
const current = (prefix: string) =>
  path.startsWith(prefix) ? 'page' : undefined;
---

<a class="skip-link" href="#main">
  Skip to content
</a>
<header class="site-header">
  <div class="header-inner shell">
    <a class="brand-link" href="/" aria-label="instantKV home">
      <img src="/assets/blueprint-mark.svg" width="22" height="22" alt="" />
      instant<span>KV</span>
    </a>
    <nav aria-label="Main navigation">
      <a href="/docs/quickstart/" aria-current={current('/docs/')}>
        Docs
      </a>
      <a href="/demo/" aria-current={current('/demo/')}>
        Demo
      </a>
      <a
        class="nav-benchmark"
        href="/benchmarks/"
        aria-current={current('/benchmarks/')}
      >
        Benchmarks
      </a>
      <a class="nav-source" href={repository}>
        GitHub <span aria-hidden="true">↗</span>
      </a>
      <details class="nav-more">
        <summary>More</summary>
        <div class="nav-more-links">
          <a href="/benchmarks/" aria-current={current('/benchmarks/')}>
            Benchmarks
          </a>
          <a href="/docs/contributing/">Contribute</a>
          <a href={repository}>GitHub ↗</a>
        </div>
      </details>
    </nav>
  </div>
</header>
