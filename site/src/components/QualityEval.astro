---
import qa from '../../../docs/benchmarks/2026-10-04-full-retrieval/qa-summary.json';
import { percent } from '../lib/evidence';
const categoryLabels: Record<string, string> = {
  'single-session-user': 'User facts',
  'single-session-assistant': 'Assistant facts',
  'single-session-preference': 'Preferences',
  'temporal-reasoning': 'Time reasoning',
  'knowledge-update': 'Updated facts',
  'multi-session': 'Multiple sessions',
  abstention: 'Abstention',
};
---

<div class="bench-qa">
  <div class="bench-qa-score">
    <span>LongMemEval-S · instantKV + GPT-6 Luna</span>
    <strong>
      {percent(qa.qa_score)}
      <small>%</small>
    </strong>
    <p>
      Answer accuracy · {qa.correct} / {qa.questions} correct
    </p>
  </div>
  <dl class="bench-qa-meta">
    <div>
      <dt>95% confidence interval</dt>
      <dd>
        {percent(qa.confidence_interval.low)}–
        {percent(qa.confidence_interval.high)}%
      </dd>
    </div>
    <div>
      <dt>API failures</dt>
      <dd>{qa.qa_failures}</dd>
    </div>
    <div>
      <dt>Evaluation coverage</dt>
      <dd>500 questions · one full pass</dd>
    </div>
  </dl>
</div>
<p class="bench-note">
  This score includes model inference. Reader and judge: GPT-6 Luna, medium
  reasoning, 16,384-token context limit. Official LongMemEval rubric with a
  different model; not official leaderboard parity. Competitor QA is incomplete.
  The model API is used for evaluation; instantKV retrieval stays local.
</p>
<details class="bench-details">
  <summary>Accuracy by task and model response time</summary>
  <div
    class="bench-comparison-scroll"
    role="region"
    aria-label="Answer accuracy by task"
    tabindex="0"
  >
    <table class="bench-comparison-table">
      <caption>All questions, including abstention</caption>
      <thead>
        <tr>
          <th scope="col">Task</th>
          <th scope="col">Questions</th>
          <th scope="col">Accuracy</th>
        </tr>
      </thead>
      <tbody>
        {Object.entries(qa.categories).map(([name, value]) => (
          <tr>
            <th scope="row">{categoryLabels[name]}</th>
            <td>{value.questions}</td>
            <td>{percent(value.qa_score)}%</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <p class="bench-note">
    Cloud reader response: p50{' '}
    {(qa.reader_api_latency_ms.p50 / 1000).toFixed(2)} s · p95{' '}
    {(qa.reader_api_latency_ms.p95 / 1000).toFixed(2)} s · p99{' '}
    {(qa.reader_api_latency_ms.p99 / 1000).toFixed(2)} s. Excludes retrieval,
    rate-limit waiting and judge calls. This is not local-model performance.
    Confidence interval: source-history-cluster bootstrap, 2,000 resamples.
  </p>
</details>
<div class="bench-downloads">
  <a href="/benchmark-data/full-retrieval/qa-summary.json">QA summary ↗</a>
  <a href="/benchmark-data/full-retrieval/longmemeval-s--instantkv--qa.jsonl">
    All 500 answers ↗
  </a>
  <a href="/benchmark-data/full-retrieval/longmemeval-s--instantkv--qa-report.json">
    Model settings ↗
  </a>
</div>
