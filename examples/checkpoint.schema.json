{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CheckpointRequest",
  "type": "object",
  "properties": {
    "agent_id": {
      "type": "string"
    },
    "capsule": {
      "$ref": "#/$defs/Capsule"
    },
    "expected_latest_revision": {
      "type": [
        "integer",
        "null"
      ],
      "format": "uint64",
      "minimum": 0
    },
    "id": {
      "type": "string"
    },
    "references": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/MemoryReference"
      }
    },
    "session_id": {
      "type": "string"
    }
  },
  "additionalProperties": false,
  "required": [
    "id",
    "agent_id",
    "session_id",
    "capsule"
  ],
  "$defs": {
    "Capsule": {
      "type": "object",
      "properties": {
        "constraints": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "decisions": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "goal": {
          "type": "string"
        },
        "next_action": {
          "type": "string"
        },
        "open_tasks": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "summary": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "goal",
        "summary",
        "next_action"
      ]
    },
    "MemoryReference": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string"
        },
        "namespace": {
          "type": "string"
        },
        "revision": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "namespace",
        "key",
        "revision"
      ]
    }
  }
}
